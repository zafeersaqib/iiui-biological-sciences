---
export interface Props {
  items: Array<{
    label: string;
    href?: string;
  }>;
}

const { items } = Astro.props;
---

<nav 
  aria-label="Breadcrumb" 
  class="sticky top-[48px] sm:top-[54px] z-40 h-[38px] sm:h-[40px] bg-white/95 dark:bg-night-900/95 backdrop-blur-md border-b border-[#D0DEC0] dark:border-night-800 text-xs text-sand-600 dark:text-sand-400 font-sans shadow-xs select-none transition-all flex items-center"
>
  <div class="max-w-7xl mx-auto w-full px-4 sm:px-6 lg:px-8">
    <ol class="flex items-center space-x-2 flex-wrap">
      <li>
        <a href="/" class="hover:text-[#163013] dark:hover:text-[#C1E899] flex items-center gap-1.5 transition-colors font-medium text-[#23491E] dark:text-[#C1E899]">
          <svg class="w-3.5 h-3.5 text-[#55883B]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
          </svg>
          <span class="font-bold">Home</span>
        </a>
      </li>
      {items.map((item, index) => (
        <li class="flex items-center space-x-2">
          <span class="text-[#A7B995]" aria-hidden="true">/</span>
          {item.href ? (
            <a href={item.href} class="hover:text-[#163013] dark:hover:text-[#C1E899] hover:underline transition-colors font-medium text-[#23491E] dark:text-[#E6F0DC]">
              {item.label}
            </a>
          ) : (
            <span class="text-[#163013] dark:text-[#C1E899] font-bold truncate max-w-xs sm:max-w-md" aria-current="page">
              {item.label}
            </span>
          )}
        </li>
      ))}
    </ol>
  </div>
</nav>
