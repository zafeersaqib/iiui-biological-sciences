---
// JHU-Style Editorial Footer with IIUI Green Identity
---

<footer class="bg-[#0D1F0C] text-[#E6F0DC] pt-16 pb-12 font-sans border-t border-[#23491E]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
    
    <!-- Top Section: 3-Column Layout -->
    <div class="grid grid-cols-1 md:grid-cols-12 gap-10 lg:gap-12">
      
      <!-- Left Column (4 cols): Crest, Address, Contact, Socials -->
      <div class="md:col-span-4 space-y-5">
        <div class="flex items-center space-x-3.5">
          <img 
            src="/assets/images/dept-logo.png" 
            alt="Department of Biological Sciences Crest" 
            class="h-16 w-auto object-contain brightness-125 drop-shadow" 
          />
          <div>
            <div class="text-[10px] uppercase tracking-widest text-[#C1E899] font-mono font-bold leading-tight">
              International Islamic University Islamabad
            </div>
            <div class="text-lg font-serif font-bold text-white leading-snug">
              Department of Biological Sciences
            </div>
            <div class="text-xs text-[#9A6735] font-semibold">Faculty of Sciences</div>
          </div>
        </div>

        <div class="space-y-2 text-xs text-[#E6F0DC]/85 font-sans leading-relaxed pt-2">
          <div class="flex items-start gap-2">
            <svg class="w-4 h-4 text-[#C1E899] shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span>Faculty of Sciences Block, Sector H-10, Islamabad, 44000, Pakistan</span>
          </div>

          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-[#C1E899] shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <span>+92 (51) 9019837 &middot; +92 (51) 9019800</span>
          </div>
        </div>

        <!-- Social Icons Row -->
        <div class="flex items-center space-x-4 pt-1">
          <a href="https://twitter.com/iiui_official" target="_blank" rel="noopener" class="text-[#E6F0DC]/70 hover:text-[#C1E899] transition-colors" aria-label="X / Twitter">
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </a>
          <a href="https://www.facebook.com/iiu.isbpk/" target="_blank" rel="noopener" class="text-[#E6F0DC]/70 hover:text-[#C1E899] transition-colors" aria-label="Facebook">
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          </a>
          <a href="https://www.linkedin.com/school/international-islamic-university-islamabad/" target="_blank" rel="noopener" class="text-[#E6F0DC]/70 hover:text-[#C1E899] transition-colors" aria-label="LinkedIn">
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
          </a>
          <a href="https://www.youtube.com/@iiuiofficial" target="_blank" rel="noopener" class="text-[#E6F0DC]/70 hover:text-[#C1E899] transition-colors" aria-label="YouTube">
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
          </a>
        </div>
      </div>

      <!-- Right Column (8 cols): Search Input + Hopkins Navigation Hierarchy -->
      <div class="md:col-span-8 space-y-6">
        
        <!-- Search Bar with Green Square Button -->
        <div class="max-w-md ml-auto flex items-center">
          <input 
            type="text" 
            placeholder="Search website..." 
            class="w-full px-4 py-2.5 bg-white text-sand-900 rounded-l text-xs focus:outline-none"
            id="footer-search-input"
            readonly
          />
          <button 
            id="footer-search-btn"
            type="button" 
            class="px-4 py-2.5 bg-[#55883B] hover:bg-[#436e2e] text-white rounded-r text-xs flex items-center justify-center transition-colors"
            aria-label="Open search dialog"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </button>
        </div>

        <!-- 2-Column Links Layout -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-8 text-xs pt-4 border-t border-[#23491E]">
          
          <!-- Column 1: Primary Categories -->
          <div class="space-y-3 font-serif font-bold text-sm text-white">
            <a href="/about" class="block hover:text-[#C1E899] transition-colors pb-1.5 border-b border-[#23491E]">About Us</a>
            <a href="/academics" class="block hover:text-[#C1E899] transition-colors pb-1.5 border-b border-[#23491E]">Academics</a>
            <a href="/academics#programs" class="block hover:text-[#C1E899] transition-colors pb-1.5 border-b border-[#23491E]">Degree Programs</a>
            <a href="/students/admissions" class="block hover:text-[#C1E899] transition-colors pb-1.5 border-b border-[#23491E]">Admissions & Aid</a>
            <a href="/people/faculty" class="block hover:text-[#C1E899] transition-colors pb-1.5 border-b border-[#23491E]">Research & Faculty</a>
            <a href="/students/societies" class="block hover:text-[#C1E899] transition-colors">Campus Life & Societies</a>
          </div>

          <!-- Column 2: Institutional & Secondary Quick Links -->
          <div class="space-y-2 text-[#E6F0DC]/80 font-sans">
            <a href="/contact" class="block hover:text-[#C1E899] transition-colors">Contact the Department</a>
            <a href="https://www.iiu.edu.pk/index.php?page_id=2701" target="_blank" rel="noopener" class="block hover:text-[#C1E899] transition-colors">Employment & Academic Vacancies</a>
            <a href="/students/guidelines" class="block hover:text-[#C1E899] transition-colors">University Regulations & Guidelines</a>
            <a href="/academics/academic-calendar" class="block hover:text-[#C1E899] transition-colors">Semester Timetables & Schedules</a>
            <a href="https://cms.iiu.edu.pk/" target="_blank" rel="noopener" class="block hover:text-[#C1E899] transition-colors">CMS Student Information Portal</a>
            <a href="https://lms.iiu.edu.pk/" target="_blank" rel="noopener" class="block hover:text-[#C1E899] transition-colors">LMS Digital Classroom</a>
            <a href="https://iiu.edu.pk/library/" target="_blank" rel="noopener" class="block hover:text-[#C1E899] transition-colors">Central Library Online Catalog</a>
            <a href="/about#facilities" class="block hover:text-[#C1E899] transition-colors">Accessibility & Campus Services</a>
          </div>

        </div>

      </div>

    </div>

    <!-- Bottom Row: Policy Links & Copyright Statement -->
    <div class="pt-8 border-t border-[#23491E] flex flex-col md:flex-row items-center justify-between gap-4 text-[11px] text-[#E6F0DC]/70 font-sans">
      <div class="flex flex-wrap items-center justify-center md:justify-start gap-4">
        <a href="/about#vision" class="hover:text-white">Privacy Statement</a>
        <span>&middot;</span>
        <a href="/about#vision" class="hover:text-white">Academic Ethics & Integrity</a>
        <span>&middot;</span>
        <a href="/about#facilities" class="hover:text-white">Accessibility</a>
        <span>&middot;</span>
        <a href="/contact" class="hover:text-white">Emergency Contact Information</a>
      </div>

      <div class="text-center md:text-right">
        &copy; 2026 Department of Biological Sciences, International Islamic University Islamabad. All rights reserved.
      </div>
    </div>

  </div>
</footer>
