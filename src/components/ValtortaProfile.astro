---
export interface Props {
  faculty: any;
  publications?: any[];
  projects?: any[];
  teaching?: any[];
  renderedContent?: string;
}

import { isRealUrl } from '../utils/links';

const { faculty, publications = [], projects = [], teaching = [], renderedContent = '' } = Astro.props;

// Group publications by year (reverse chronological)
const publicationsByYear = publications.reduce((acc: Record<number, any[]>, pub: any) => {
  const yr = pub.year || 2024;
  if (!acc[yr]) acc[yr] = [];
  acc[yr].push(pub);
  return acc;
}, {});

const sortedYears = Object.keys(publicationsByYear).map(Number).sort((a, b) => b - a);

// Profile URL for QR code & sharing
const profileUrl = Astro.url.href;
---

<div class="relative bg-sand-50 dark:bg-night-950 pb-20">
  
  <!-- 1. Frozen Green Faculty Banner (Sticky, always visible on scroll) -->
  <div class="sticky top-[86px] sm:top-[94px] z-30 bg-[#163013] text-white border-b border-[#23491E] shadow-md transition-all">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-2 sm:py-2.5 flex flex-col md:flex-row md:items-center justify-between gap-2 sm:gap-4">
      <div class="min-w-0">
        <div class="flex items-center gap-2">
          <span class="inline-block px-2.5 py-0.5 rounded-full bg-[#C1E899] text-[#0D1F0C] font-sans font-bold text-[10px] tracking-wider uppercase">
            {faculty.role || "Faculty Scholar"}
          </span>
          <span class="text-xs text-[#C1E899]/80 font-sans hidden sm:inline">&bull; Department of Biological Sciences</span>
        </div>
        <h1 class="text-lg sm:text-xl md:text-2xl font-serif font-bold text-white tracking-tight truncate mt-0.5">
          {faculty.name}
        </h1>
        <p class="text-xs text-[#E6F0DC]/90 font-sans truncate">
          {faculty.designation} &bull; Faculty of Sciences, IIUI
        </p>
      </div>

      <!-- Quick Action Badges -->
      <div class="flex items-center gap-2 sm:gap-3 flex-shrink-0">
        {faculty.email && (
          <a 
            href={`mailto:${faculty.email}`} 
            class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded bg-[#23491E] hover:bg-[#55883B] text-white text-xs font-sans font-medium transition-colors border border-[#55883B]/40"
            title={`Email ${faculty.name}`}
          >
            <svg class="w-3.5 h-3.5 text-[#C1E899]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
            <span class="hidden sm:inline">Email</span>
          </a>
        )}
        <a 
          href={faculty.cv_pdf || `/downloads/cv/cv-${faculty.slug}.pdf`} 
          download 
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded bg-white hover:bg-[#E6F0DC] text-[#163013] text-xs font-sans font-bold transition-colors shadow-sm"
          title="Download Curriculum Vitae"
        >
          <svg class="w-3.5 h-3.5 text-[#55883B]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
          </svg>
          <span>Download CV</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Main Container: Sticky Sidebar + Content Area -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
      
      <!-- 2. Sticky Left Sidebar (Desktop Sticky) -->
      <aside class="lg:col-span-4 self-start lg:sticky lg:top-[178px] z-20 space-y-6">
        <div class="bg-white dark:bg-night-900 rounded-2xl shadow-xl border border-sand-200 dark:border-night-800 p-6 sm:p-8 text-center relative max-h-[calc(100vh-195px)] overflow-y-auto">
          
          <!-- Subtle Accent Ring behind Avatar -->
          <div class="mx-auto w-36 h-36 sm:w-44 sm:h-44 rounded-full p-1.5 bg-gradient-to-tr from-forest-800 via-gold-500 to-forest-600 shadow-lg">
            <div class="w-full h-full rounded-full overflow-hidden bg-sand-200 dark:bg-night-800 flex items-center justify-center">
              {faculty.avatar ? (
                <img 
                  src={faculty.avatar} 
                  alt={`Portrait of ${faculty.name}`}
                  class="w-full h-full object-cover"
                  onerror="this.src='/assets/images/faculty-placeholder.svg'"
                />
              ) : (
                <div class="text-3xl font-display font-bold text-forest-800 dark:text-gold-400">
                  {faculty.name.split(' ').map((n: string) => n[0]).join('')}
                </div>
              )}
            </div>
          </div>

          <!-- Academic Affiliation -->
          <h2 class="mt-4 text-xl font-display font-bold text-sand-900 dark:text-sand-100">{faculty.name}</h2>
          <div class="text-xs font-semibold text-forest-700 dark:text-gold-400 mt-0.5">{faculty.designation}</div>
          <div class="text-xs text-sand-600 dark:text-sand-400 mt-1">
            Department of Biological Sciences<br />
            Faculty of Sciences, IIUI
          </div>

          <!-- Verified Academic Badges / Links -->
          <div class="mt-6 pt-6 border-t border-sand-200 dark:border-night-800 flex flex-wrap justify-center gap-2">
            
            {isRealUrl(faculty.scholar_url) && (
              <a href={faculty.scholar_url} target="_blank" rel="noopener" class="p-2 rounded-full bg-sand-100 dark:bg-night-800 hover:bg-forest-100 dark:hover:bg-forest-900 text-sand-700 dark:text-sand-300 hover:text-forest-800 transition-colors" title="Google Scholar">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 24a7 7 0 1 1 0-14 7 7 0 0 1 0 14zm0-24L0 9.5l4.838 3.94A8 8 0 0 1 12 9a8 8 0 0 1 7.162 4.44L24 9.5z"/>
                </svg>
              </a>
            )}

            {isRealUrl(faculty.orcid_url) && (
              <a href={faculty.orcid_url} target="_blank" rel="noopener" class="p-2 rounded-full bg-sand-100 dark:bg-night-800 hover:bg-[#A6CE39]/20 text-[#A6CE39] transition-colors" title="ORCID Profile">
                <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 0C5.372 0 0 5.372 0 12s5.372 12 12 12 12-5.372 12-12S18.628 0 12 0zM7.369 4.378c.525 0 .947.431.947.947s-.422.947-.947.947a.95.95 0 0 1-.947-.947c0-.525.422-.947.947-.947zm-.722 3.038h1.444v10.041H6.647V7.416zm3.562 0h3.9c3.712 0 5.344 2.653 5.344 5.025 0 2.578-2.016 5.016-5.325 5.016h-3.919V7.416zm1.444 1.303v7.444h2.297c2.359 0 3.869-1.463 3.869-3.722 0-2.141-1.428-3.722-3.828-3.722h-2.338z"/>
                </svg>
              </a>
            )}

            {isRealUrl(faculty.researchgate_url) && (
              <a href={faculty.researchgate_url} target="_blank" rel="noopener" class="p-2 rounded-full bg-sand-100 dark:bg-night-800 hover:bg-[#00CCBB]/20 text-[#00CCBB] transition-colors" title="ResearchGate">
                <span class="text-xs font-bold leading-none">RG</span>
              </a>
            )}

            {isRealUrl(faculty.linkedin_url) && (
              <a href={faculty.linkedin_url} target="_blank" rel="noopener" class="p-2 rounded-full bg-sand-100 dark:bg-night-800 hover:bg-blue-100 dark:hover:bg-blue-900 text-blue-600 transition-colors" title="LinkedIn">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
                </svg>
              </a>
            )}

            {isRealUrl(faculty.x_url) && (
              <a href={faculty.x_url} target="_blank" rel="noopener" class="p-2 rounded-full bg-sand-100 dark:bg-night-800 hover:bg-sand-200 dark:hover:bg-night-700 text-sand-800 dark:text-sand-200 transition-colors" title="X (Twitter)">
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                </svg>
              </a>
            )}

            <a href={`mailto:${faculty.email}`} class="p-2 rounded-full bg-sand-100 dark:bg-night-800 hover:bg-forest-100 dark:hover:bg-forest-900 text-forest-800 dark:text-gold-400 transition-colors" title={`Email ${faculty.name}`}>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
            </a>

          </div>

          <!-- Direct Coordinates -->
          <div class="mt-6 pt-6 border-t border-sand-200 dark:border-night-800 text-left text-xs space-y-2.5 text-sand-600 dark:text-sand-400">
            <div class="flex items-start gap-2">
              <svg class="w-4 h-4 text-forest-700 dark:text-gold-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
              </svg>
              <span>{faculty.office}</span>
            </div>
            {faculty.phone && (
              <div class="flex items-center gap-2">
                <svg class="w-4 h-4 text-forest-700 dark:text-gold-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                </svg>
                <span>{faculty.phone}</span>
              </div>
            )}
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4 text-forest-700 dark:text-gold-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 12a4 4 0 10-8 0 4 4 0 008 0zm0 0v1.5a2.5 2.5 0 005 0V12a9 9 0 10-9 9m4.5-1.206a8.959 8.959 0 01-4.5 1.207"/>
              </svg>
              <a href={`mailto:${faculty.email}`} class="text-forest-700 dark:text-gold-400 hover:underline">{faculty.email}</a>
            </div>
          </div>

          <!-- Share & QR Code Trigger -->
          <div class="mt-6 pt-4 border-t border-sand-100 dark:border-night-800 flex items-center justify-between text-xs text-sand-500">
            <button id="profile-share-btn" type="button" class="inline-flex items-center gap-1.5 hover:text-forest-800 dark:hover:text-gold-400">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z"/>
              </svg>
              <span>Share Profile</span>
            </button>
            <button id="profile-qr-btn" type="button" class="inline-flex items-center gap-1.5 hover:text-forest-800 dark:hover:text-gold-400">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v1m6 11h2m-6 0h-2v4m0-11v3m0 0h.01M12 12h4.01M16 20h4M4 12h4m12 0h.01M5 8h2a1 1 0 001-1V5a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1zm12 0h2a1 1 0 001-1V5a1 1 0 00-1-1h-2a1 1 0 00-1 1v2a1 1 0 001 1zM5 20h2a1 1 0 001-1v-2a1 1 0 00-1-1H5a1 1 0 00-1 1v2a1 1 0 001 1z"/>
              </svg>
              <span>QR Code</span>
            </button>
          </div>

        </div>
      </aside>

      <!-- 3. Right Content Area: Profile Tabs -->
      <section class="lg:col-span-8 bg-white dark:bg-night-900 rounded-2xl shadow-xl border border-sand-200 dark:border-night-800">
        
        <!-- Tab Navigation Bar: Sticky Floating below Frozen Name Banner -->
        <nav 
          aria-label="Profile Sections" 
          class="sticky top-[178px] z-20 flex border-b border-sand-200 dark:border-night-800 overflow-x-auto bg-white/95 dark:bg-night-900/95 backdrop-blur-md shadow-sm rounded-t-2xl"
        >
          <button class="profile-tab-btn active px-5 py-3.5 text-xs sm:text-sm font-semibold border-b-2 border-[#23491E] text-[#163013] dark:text-[#C1E899] dark:border-[#C1E899] whitespace-nowrap focus:outline-none" data-tab="about">
            About
          </button>
          <button class="profile-tab-btn px-5 py-3.5 text-xs sm:text-sm font-semibold border-b-2 border-transparent text-sand-600 dark:text-sand-400 hover:text-[#163013] dark:hover:text-[#C1E899] whitespace-nowrap focus:outline-none" data-tab="publications">
            Publications ({publications.length})
          </button>
          <button class="profile-tab-btn px-5 py-3.5 text-xs sm:text-sm font-semibold border-b-2 border-transparent text-sand-600 dark:text-sand-400 hover:text-[#163013] dark:hover:text-[#C1E899] whitespace-nowrap focus:outline-none" data-tab="projects">
            Projects ({projects.length})
          </button>
          <button class="profile-tab-btn px-5 py-3.5 text-xs sm:text-sm font-semibold border-b-2 border-transparent text-sand-600 dark:text-sand-400 hover:text-[#163013] dark:hover:text-[#C1E899] whitespace-nowrap focus:outline-none" data-tab="teaching">
            Teaching ({teaching.length})
          </button>
          <button class="profile-tab-btn px-5 py-3.5 text-xs sm:text-sm font-semibold border-b-2 border-transparent text-sand-600 dark:text-sand-400 hover:text-[#163013] dark:hover:text-[#C1E899] whitespace-nowrap focus:outline-none" data-tab="cv">
            CV & Career
          </button>
          <button class="profile-tab-btn px-5 py-3.5 text-xs sm:text-sm font-semibold border-b-2 border-transparent text-sand-600 dark:text-sand-400 hover:text-[#163013] dark:hover:text-[#C1E899] whitespace-nowrap focus:outline-none" data-tab="contact">
            Contact
          </button>
        </nav>

        <div class="p-6 sm:p-10">
          
          <!-- TAB 1: ABOUT -->
          <div id="tab-content-about" class="profile-tab-pane space-y-8">
            <!-- 1-line research summary in large text -->
            <div class="p-6 rounded-xl bg-forest-50 dark:bg-night-800 border-l-4 border-forest-800 dark:border-gold-400">
              <p class="text-base sm:text-xl font-display italic text-forest-900 dark:text-sand-100 leading-relaxed">
                "{faculty.short_summary}"
              </p>
            </div>

            <!-- Narrative Bio -->
            <div class="prose dark:prose-invert max-w-none text-sand-800 dark:text-sand-200 leading-relaxed font-sans">
              {renderedContent ? <div set:html={renderedContent} /> : <slot />}
            </div>

            <!-- Research Interests Badges -->
            <div class="pt-6 border-t border-sand-200 dark:border-night-800">
              <h3 class="text-xs font-semibold uppercase tracking-wider text-sand-500 dark:text-sand-400 mb-3">Primary Research Domains</h3>
              <div class="flex flex-wrap gap-2">
                {faculty.research_interests.map((interest: string) => (
                  <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-sand-100 dark:bg-night-800 text-forest-800 dark:text-gold-400 border border-sand-200 dark:border-night-700">
                    {interest}
                  </span>
                ))}
              </div>
            </div>
          </div>

          <!-- TAB 2: PUBLICATIONS (Grouped by year, filterable by type) -->
          <div id="tab-content-publications" class="profile-tab-pane hidden space-y-6">
            
            <!-- Filter Bar -->
            <div class="flex flex-wrap items-center justify-between gap-4 pb-4 border-b border-sand-200 dark:border-night-800">
              <div class="text-xs text-sand-500">Filter by category:</div>
              <div class="flex flex-wrap gap-2 text-xs" id="pub-filter-buttons">
                <button class="pub-filter-btn active px-3 py-1 rounded-full bg-forest-800 text-white font-medium" data-filter="all">All ({publications.length})</button>
                <button class="pub-filter-btn px-3 py-1 rounded-full bg-sand-100 dark:bg-night-800 text-sand-700 dark:text-sand-300 hover:bg-forest-100 dark:hover:bg-night-700" data-filter="journal">Refereed Journals</button>
                <button class="pub-filter-btn px-3 py-1 rounded-full bg-sand-100 dark:bg-night-800 text-sand-700 dark:text-sand-300 hover:bg-forest-100 dark:hover:bg-night-700" data-filter="book_chapter">Book Chapters</button>
                <button class="pub-filter-btn px-3 py-1 rounded-full bg-sand-100 dark:bg-night-800 text-sand-700 dark:text-sand-300 hover:bg-forest-100 dark:hover:bg-night-700" data-filter="conference">Conference Papers</button>
              </div>
            </div>

            <!-- Publications list grouped by year -->
            {sortedYears.map((year) => (
              <div class="space-y-4">
                <div class="py-1.5 border-b border-sand-200 dark:border-night-800 flex items-center gap-3">
                  <span class="text-lg font-display font-bold text-forest-800 dark:text-gold-400">{year}</span>
                  <span class="text-xs text-sand-400">({publicationsByYear[year].length} publications)</span>
                </div>

                <div class="space-y-4">
                  {publicationsByYear[year].map((pub: any) => (
                    <article class="pub-item p-4 rounded-xl border border-sand-200 dark:border-night-800 hover:border-forest-700 dark:hover:border-gold-500/50 transition-colors" data-type={pub.type || 'journal'}>
                      <div class="flex items-start justify-between gap-4">
                        <div class="space-y-1.5">
                          <span class="inline-block px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-forest-100 dark:bg-forest-950 text-forest-800 dark:text-forest-400">
                            {pub.type?.replace('_', ' ') || 'Journal'}
                          </span>
                          <h4 class="text-sm sm:text-base font-semibold text-sand-900 dark:text-sand-100 leading-snug">
                            {pub.title}
                          </h4>
                          <div class="text-xs text-sand-600 dark:text-sand-400">
                            <span class="font-medium text-sand-800 dark:text-sand-200">{pub.authors}</span> &bull; 
                            <span class="italic font-display">{pub.journal || pub.book_title || pub.conference}</span>
                            {pub.volume && ` (${pub.volume})`}
                            {pub.pages && `: pp. ${pub.pages}`}
                          </div>
                          {pub.abstract && (
                            <p class="text-xs text-sand-600 dark:text-sand-400 pt-1 line-clamp-2">{pub.abstract}</p>
                          )}
                        </div>

                        {isRealUrl(pub.doi) && (
                          <a 
                            href={pub.doi} 
                            target="_blank" 
                            rel="noopener"
                            class="shrink-0 inline-flex items-center gap-1 px-2.5 py-1 rounded bg-sand-100 dark:bg-night-800 hover:bg-forest-800 hover:text-white dark:hover:bg-gold-500 dark:hover:text-night-950 text-[11px] font-medium transition-colors"
                          >
                            <span>DOI</span>
                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                            </svg>
                          </a>
                        )}
                      </div>
                    </article>
                  ))}
                </div>
              </div>
            ))}
          </div>

          <!-- TAB 3: PROJECTS (Cards with title, funder, role, years, status) -->
          <div id="tab-content-projects" class="profile-tab-pane hidden space-y-6">
            <div class="grid grid-cols-1 gap-6">
              {projects.map((proj: any) => (
                <div class="p-6 rounded-xl border border-sand-200 dark:border-night-800 bg-sand-50/50 dark:bg-night-850/50 space-y-3">
                  <div class="flex flex-wrap items-center justify-between gap-2">
                    <span class={`inline-block px-2.5 py-0.5 rounded-full text-xs font-semibold uppercase tracking-wider ${proj.status === 'Active' ? 'bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-400' : 'bg-sand-200 text-sand-700 dark:bg-night-800 dark:text-sand-400'}`}>
                      {proj.status || 'Active'}
                    </span>
                    <span class="text-xs font-mono text-sand-500">{proj.grant_number || ''}</span>
                  </div>

                  <h3 class="text-base sm:text-lg font-display font-bold text-sand-900 dark:text-sand-100 leading-snug">
                    {proj.title}
                  </h3>

                  <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-2 text-xs text-sand-600 dark:text-sand-400 border-t border-sand-200 dark:border-night-800">
                    <div>
                      <span class="block text-sand-400 text-[10px] uppercase font-semibold">Funding Body</span>
                      <span class="font-medium text-sand-800 dark:text-sand-200">{proj.funding_agency}</span>
                    </div>
                    <div>
                      <span class="block text-sand-400 text-[10px] uppercase font-semibold">Role & Duration</span>
                      <span class="font-medium text-sand-800 dark:text-sand-200">{proj.role} ({proj.duration})</span>
                    </div>
                    <div>
                      <span class="block text-sand-400 text-[10px] uppercase font-semibold">Grant Value</span>
                      <span class="font-medium text-forest-800 dark:text-gold-400 font-mono">{proj.amount}</span>
                    </div>
                  </div>

                  {proj.description && (
                    <p class="text-xs text-sand-600 dark:text-sand-400 pt-1 leading-relaxed">{proj.description}</p>
                  )}
                </div>
              ))}
            </div>
          </div>

          <!-- TAB 4: TEACHING (Courses taught linked to curriculum) -->
          <div id="tab-content-teaching" class="profile-tab-pane hidden space-y-6">
            <div class="divide-y divide-sand-200 dark:divide-night-800">
              {teaching.map((course: any) => (
                <div class="py-5 space-y-2">
                  <div class="flex flex-wrap items-center justify-between gap-2">
                    <div class="flex items-center gap-2">
                      <span class="px-2 py-0.5 rounded font-mono text-xs font-bold bg-forest-100 text-forest-800 dark:bg-forest-950 dark:text-forest-400">
                        {course.code}
                      </span>
                      <span class="text-xs font-medium text-gold-600 dark:text-gold-400">{course.level}</span>
                    </div>
                    <span class="text-xs text-sand-500 font-mono">{course.credits}</span>
                  </div>

                  <h3 class="text-base font-semibold text-sand-900 dark:text-sand-100">
                    {course.title}
                  </h3>

                  <p class="text-xs text-sand-600 dark:text-sand-400 leading-relaxed">
                    {course.description}
                  </p>

                  {course.link && (
                    <a href={course.link} class="inline-flex items-center gap-1 text-xs text-forest-800 dark:text-gold-400 font-medium hover:underline pt-1">
                      <span>View Program Scheme of Studies</span>
                      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                      </svg>
                    </a>
                  )}
                </div>
              ))}
            </div>
          </div>

          <!-- TAB 5: CV & CAREER (Timeline & PDF Download) -->
          <div id="tab-content-cv" class="profile-tab-pane hidden space-y-8">
            
            <!-- Download Button -->
            <div class="flex flex-wrap items-center justify-between p-4 rounded-xl bg-forest-50 dark:bg-night-850 border border-forest-200 dark:border-night-700 gap-4">
              <div>
                <h4 class="text-sm font-semibold text-forest-900 dark:text-gold-400">Official Curriculum Vitae</h4>
                <p class="text-xs text-sand-600 dark:text-sand-400">Verified document including full academic record, thesis supervision, and grants.</p>
              </div>
              <a 
                href={faculty.cv_pdf || '#'} 
                download
                class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-forest-800 hover:bg-forest-900 text-white text-xs font-semibold shadow-sm transition-colors"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
                </svg>
                <span>Download CV (PDF)</span>
              </a>
            </div>

            <!-- Education Timeline -->
            <div class="space-y-4">
              <h3 class="text-sm font-display font-bold uppercase tracking-wider text-forest-800 dark:text-gold-400 border-b border-sand-200 dark:border-night-800 pb-2">
                Academic Degrees & Post-Doctoral Qualifications
              </h3>
              <ol class="relative border-l-2 border-forest-800/30 dark:border-gold-500/30 ml-3 space-y-6">
                {faculty.education?.map((item: any) => (
                  <li class="ml-6">
                    <span class="absolute -left-2 flex items-center justify-center w-4 h-4 bg-forest-800 dark:bg-gold-400 rounded-full ring-4 ring-white dark:ring-night-900"></span>
                    <span class="text-xs font-mono font-semibold text-gold-600 dark:text-gold-400">{item.year}</span>
                    <h4 class="text-sm font-semibold text-sand-900 dark:text-sand-100">{item.degree}</h4>
                    <p class="text-xs text-sand-600 dark:text-sand-400">{item.institution}</p>
                  </li>
                ))}
              </ol>
            </div>

            <!-- Appointments & Positions Timeline -->
            <div class="space-y-4 pt-4">
              <h3 class="text-sm font-display font-bold uppercase tracking-wider text-forest-800 dark:text-gold-400 border-b border-sand-200 dark:border-night-800 pb-2">
                Academic & Administrative Appointments
              </h3>
              <ol class="relative border-l-2 border-sand-300 dark:border-night-700 ml-3 space-y-6">
                {faculty.positions?.map((pos: any) => (
                  <li class="ml-6">
                    <span class="absolute -left-2 flex items-center justify-center w-4 h-4 bg-sand-400 dark:bg-night-700 rounded-full ring-4 ring-white dark:ring-night-900"></span>
                    <span class="text-xs font-mono font-semibold text-sand-500">{pos.period}</span>
                    <h4 class="text-sm font-semibold text-sand-900 dark:text-sand-100">{pos.title}</h4>
                    <p class="text-xs text-sand-600 dark:text-sand-400">{pos.institution}</p>
                  </li>
                ))}
              </ol>
            </div>

          </div>

          <!-- TAB 6: CONTACT (Direct Form & Visiting Hours) -->
          <div id="tab-content-contact" class="profile-tab-pane hidden space-y-6">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
              
              <!-- Left: Office Coordinates -->
              <div class="space-y-4 text-sm text-sand-700 dark:text-sand-300">
                <h3 class="text-lg font-display font-bold text-forest-800 dark:text-gold-400">Consultation & Office Hours</h3>
                <p class="text-xs leading-relaxed text-sand-600 dark:text-sand-400">
                  Prospective research scholars, thesis advisees, and industrial collaborators can schedule appointments during open consulting windows:
                </p>
                <div class="p-4 rounded-lg bg-sand-100 dark:bg-night-800 space-y-2 text-xs">
                  <div class="flex justify-between font-medium">
                    <span>Tuesday & Thursday:</span>
                    <span class="text-forest-800 dark:text-gold-400">11:00 AM – 01:00 PM</span>
                  </div>
                  <div class="flex justify-between font-medium">
                    <span>Friday:</span>
                    <span class="text-forest-800 dark:text-gold-400">09:30 AM – 11:30 AM</span>
                  </div>
                </div>
                <div class="text-xs space-y-1 pt-2">
                  <p><strong class="text-sand-900 dark:text-sand-100">Office:</strong> {faculty.office}</p>
                  <p><strong class="text-sand-900 dark:text-sand-100">Direct Email:</strong> <a href={`mailto:${faculty.email}`} class="text-forest-800 dark:text-gold-400 underline">{faculty.email}</a></p>
                </div>
              </div>

              <!-- Right: Direct Message Form -->
              <form action={`mailto:${faculty.email}`} method="GET" class="space-y-4">
                <div>
                  <label for="contact-name" class="block text-xs font-medium text-sand-700 dark:text-sand-300">Your Full Name</label>
                  <input type="text" id="contact-name" name="name" required class="mt-1 w-full px-3 py-2 text-xs rounded border border-sand-300 dark:border-night-700 bg-white dark:bg-night-950 focus:ring-1 focus:ring-forest-700" />
                </div>
                <div>
                  <label for="contact-email" class="block text-xs font-medium text-sand-700 dark:text-sand-300">Your Email Address</label>
                  <input type="email" id="contact-email" name="email" required class="mt-1 w-full px-3 py-2 text-xs rounded border border-sand-300 dark:border-night-700 bg-white dark:bg-night-950 focus:ring-1 focus:ring-forest-700" />
                </div>
                <div>
                  <label for="contact-subject" class="block text-xs font-medium text-sand-700 dark:text-sand-300">Subject</label>
                  <input type="text" id="contact-subject" name="subject" value={`Academic Inquiry for ${faculty.name}`} class="mt-1 w-full px-3 py-2 text-xs rounded border border-sand-300 dark:border-night-700 bg-white dark:bg-night-950 focus:ring-1 focus:ring-forest-700" />
                </div>
                <div>
                  <label for="contact-message" class="block text-xs font-medium text-sand-700 dark:text-sand-300">Message / Research Inquiry</label>
                  <textarea id="contact-message" name="body" rows="4" required class="mt-1 w-full px-3 py-2 text-xs rounded border border-sand-300 dark:border-night-700 bg-white dark:bg-night-950 focus:ring-1 focus:ring-forest-700"></textarea>
                </div>
                <button type="submit" class="w-full py-2.5 px-4 rounded-md bg-forest-800 hover:bg-forest-900 text-white text-xs font-semibold shadow transition-colors">
                  Send Direct Inquiry &rarr;
                </button>
              </form>

            </div>
          </div>

        </div>
      </section>

    </div>
  </div>

  <!-- QR Code & Share Modal -->
  <div id="qr-modal" class="fixed inset-0 z-50 hidden bg-black/60 backdrop-blur-sm p-4 flex justify-center items-center">
    <div class="bg-white dark:bg-night-900 rounded-xl max-w-sm w-full p-6 text-center space-y-4 border border-sand-200 dark:border-night-700">
      <h3 class="text-base font-display font-bold text-sand-900 dark:text-sand-100">Scholar Profile QR Code</h3>
      <div class="mx-auto w-48 h-48 bg-white p-2 rounded-lg border border-sand-200 flex items-center justify-center">
        <!-- SVG Generated QR placeholder pointing to profileUrl -->
        <img 
          src={`https://api.qrserver.com/v1/create-qr-code/?size=180x180&data=${encodeURIComponent(profileUrl)}`} 
          alt={`QR Code for ${faculty.name}`}
          class="w-full h-full object-contain"
        />
      </div>
      <p class="text-xs text-sand-500 font-mono break-all">{profileUrl}</p>
      <button id="close-qr-btn" type="button" class="w-full py-2 rounded bg-sand-100 dark:bg-night-800 text-xs font-semibold text-sand-800 dark:text-sand-200 hover:bg-sand-200">
        Close
      </button>
    </div>
  </div>

</div>

<script>
  // Tab Switching Logic
  const tabButtons = document.querySelectorAll('.profile-tab-btn');
  const tabPanes = document.querySelectorAll('.profile-tab-pane');

  tabButtons.forEach(button => {
    button.addEventListener('click', () => {
      const targetTab = button.getAttribute('data-tab');

      // Update button styles
      tabButtons.forEach(btn => {
        btn.classList.remove('border-forest-800', 'text-forest-800', 'dark:text-gold-400', 'dark:border-gold-400');
        btn.classList.add('border-transparent', 'text-sand-600', 'dark:text-sand-400');
      });
      button.classList.remove('border-transparent', 'text-sand-600', 'dark:text-sand-400');
      button.classList.add('border-forest-800', 'text-forest-800', 'dark:text-gold-400', 'dark:border-gold-400');

      // Update pane visibility
      tabPanes.forEach(pane => {
        pane.classList.add('hidden');
      });
      const activePane = document.getElementById(`tab-content-${targetTab}`);
      activePane?.classList.remove('hidden');
    });
  });

  // Publication Filtering Logic
  const filterBtns = document.querySelectorAll('.pub-filter-btn');
  const pubItems = document.querySelectorAll('.pub-item');

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const filter = btn.getAttribute('data-filter');

      filterBtns.forEach(b => {
        b.classList.remove('bg-forest-800', 'text-white');
        b.classList.add('bg-sand-100', 'text-sand-700', 'dark:bg-night-800', 'dark:text-sand-300');
      });
      btn.classList.add('bg-forest-800', 'text-white');
      btn.classList.remove('bg-sand-100', 'text-sand-700', 'dark:bg-night-800', 'dark:text-sand-300');

      pubItems.forEach(item => {
        const itemType = item.getAttribute('data-type');
        if (filter === 'all' || itemType === filter) {
          (item as HTMLElement).style.display = 'block';
        } else {
          (item as HTMLElement).style.display = 'none';
        }
      });
    });
  });

  // QR Modal Logic
  const qrBtn = document.getElementById('profile-qr-btn');
  const qrModal = document.getElementById('qr-modal');
  const closeQrBtn = document.getElementById('close-qr-btn');

  qrBtn?.addEventListener('click', () => qrModal?.classList.remove('hidden'));
  closeQrBtn?.addEventListener('click', () => qrModal?.classList.add('hidden'));
  qrModal?.addEventListener('click', (e) => {
    if (e.target === qrModal) qrModal.classList.add('hidden');
  });

  // Native Web Share API
  const shareBtn = document.getElementById('profile-share-btn');
  shareBtn?.addEventListener('click', async () => {
    if (navigator.share) {
      try {
        await navigator.share({
          title: document.title,
          url: window.location.href,
        });
      } catch (err) {
        console.log('Share dismissed');
      }
    } else {
      navigator.clipboard.writeText(window.location.href);
      alert('Profile link copied to clipboard!');
    }
  });
</script>
