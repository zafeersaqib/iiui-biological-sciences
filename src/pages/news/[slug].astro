---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const news = await getCollection('news');
  return news.map((item) => ({
    params: { slug: item.slug },
    props: { item },
  }));
}

const { item } = Astro.props;
const { Content } = await item.render();
---

<Layout 
  title={`${item.data.title} | Department News`}
  description={item.data.summary}
  type="article"
>
  <Breadcrumb 
    items={[
      { label: 'News & Events', href: '/news' },
      { label: item.data.title }
    ]} 
  />

  <article class="py-12 bg-white dark:bg-night-950">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
      
      <!-- Article Header -->
      <header class="space-y-4 border-b border-sand-200 dark:border-night-800 pb-6">
        <div class="flex items-center gap-3 text-xs">
          <span class="px-2.5 py-0.5 rounded font-semibold uppercase bg-forest-100 text-forest-800 dark:bg-forest-950 dark:text-forest-400">
            {item.data.category}
          </span>
          <span class="text-sand-400">&bull;</span>
          <time class="text-sand-500 font-mono">
            {new Date(item.data.date).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
          </time>
          <span class="text-sand-400">&bull;</span>
          <span class="text-sand-500">{item.data.author}</span>
        </div>

        <h1 class="text-2xl sm:text-4xl font-display font-bold text-sand-900 dark:text-sand-100 leading-tight">
          {item.data.title}
        </h1>

        <p class="text-sm sm:text-base text-sand-600 dark:text-sand-400 leading-relaxed font-sans">
          {item.data.summary}
        </p>
      </header>

      <!-- Article Body -->
      <div class="prose dark:prose-invert max-w-none text-sand-800 dark:text-sand-200 leading-relaxed font-sans text-sm sm:text-base">
        <Content />
      </div>

      <!-- Tags & Share Footer -->
      <footer class="pt-8 border-t border-sand-200 dark:border-night-800 flex flex-wrap justify-between items-center gap-4 text-xs">
        <div class="flex flex-wrap gap-2 items-center">
          <span class="text-sand-500">Filed under:</span>
          {item.data.tags.map((tag: string) => (
            <span class="px-2.5 py-1 rounded-full bg-sand-100 dark:bg-night-900 text-sand-700 dark:text-sand-300 font-medium">
              #{tag}
            </span>
          ))}
        </div>
        <a href="/news" class="text-forest-800 dark:text-gold-400 font-semibold hover:underline">
          &larr; Return to News & Events Hub
        </a>
      </footer>

    </div>
  </article>
</Layout>
