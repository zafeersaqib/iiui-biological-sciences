---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { getCollection } from 'astro:content';

const news = await getCollection('news');
const sortedNews = news.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const events = await getCollection('events');
---

<Layout 
  title="News & Events Hub | Department of Biological Sciences, IIUI"
  description="Stay up to date with research breakthroughs, HEC grants, symposium announcements, and academic seminars at the Department of Biological Sciences, IIUI."
>
  <Breadcrumb items={[{ label: 'News & Events' }]} />

  <section class="py-12 bg-white dark:bg-night-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
      
      <div class="max-w-3xl space-y-3">
        <span class="text-xs font-semibold uppercase tracking-wider text-forest-800 dark:text-gold-400 font-sans">
          Departmental Dispatches & Seminars
        </span>
        <h1 class="text-3xl sm:text-5xl font-display font-bold text-sand-900 dark:text-sand-100">
          News & Upcoming Events
        </h1>
        <p class="text-sand-600 dark:text-sand-400 text-sm leading-relaxed">
          Discover latest research announcements, HEC competitive grant awards, international symposium schedules, and academic workshops.
        </p>
      </div>

      <!-- News Section -->
      <div class="space-y-6">
        <h2 class="text-2xl font-display font-bold text-sand-900 dark:text-sand-100 border-b border-sand-200 dark:border-night-800 pb-3">
          Latest Department News
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {sortedNews.map((item) => (
            <article class="p-6 rounded-2xl border border-sand-200 dark:border-night-800 bg-sand-50/50 dark:bg-night-900 hover:border-forest-700 dark:hover:border-gold-500/50 transition-all shadow-sm flex flex-col justify-between">
              <div class="space-y-3">
                <div class="flex items-center gap-2 text-xs">
                  <span class="px-2 py-0.5 rounded text-[10px] font-semibold uppercase bg-forest-100 text-forest-800 dark:bg-forest-950 dark:text-forest-400">
                    {item.data.category}
                  </span>
                  <span class="text-sand-400">&bull;</span>
                  <time class="text-sand-500 font-mono">{new Date(item.data.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</time>
                </div>
                <h3 class="text-base font-display font-bold text-sand-900 dark:text-sand-100 leading-snug hover:text-forest-800 dark:hover:text-gold-400 transition-colors">
                  <a href={`/news/${item.slug}`}>{item.data.title}</a>
                </h3>
                <p class="text-xs text-sand-600 dark:text-sand-400 leading-relaxed line-clamp-3">
                  {item.data.summary}
                </p>
              </div>

              <div class="mt-6 pt-4 border-t border-sand-200 dark:border-night-800">
                <a href={`/news/${item.slug}`} class="text-xs font-semibold text-forest-800 dark:text-gold-400 hover:underline inline-flex items-center gap-1">
                  <span>Read Full Article &rarr;</span>
                </a>
              </div>
            </article>
          ))}
        </div>
      </div>

      <!-- Events Section -->
      <div class="space-y-6 pt-6">
        <h2 class="text-2xl font-display font-bold text-sand-900 dark:text-sand-100 border-b border-sand-200 dark:border-night-800 pb-3">
          Academic Seminars, Workshops & Conferences
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          {events.map((evt) => (
            <div class="p-6 rounded-2xl border border-sand-200 dark:border-night-800 bg-white dark:bg-night-900 shadow-sm space-y-4 flex flex-col justify-between">
              <div class="space-y-3">
                <div class="flex items-center gap-3">
                  <div class="w-14 h-14 rounded-xl bg-forest-800 text-white flex flex-col items-center justify-center font-display shrink-0 shadow-md">
                    <span class="text-xs font-bold leading-none uppercase">{new Date(evt.data.date).toLocaleDateString('en-US', { month: 'short' })}</span>
                    <span class="text-lg font-extrabold leading-none mt-1">{new Date(evt.data.date).getDate()}</span>
                  </div>
                  <div>
                    <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase bg-gold-100 text-gold-800 dark:bg-gold-950 dark:text-gold-400">
                      {evt.data.category}
                    </span>
                    <h3 class="text-base font-display font-bold text-sand-900 dark:text-sand-100 mt-1">
                      <a href={`/events/${evt.slug}`} class="hover:text-forest-800 dark:hover:text-gold-400 transition-colors">
                        {evt.data.title}
                      </a>
                    </h3>
                  </div>
                </div>

                <div class="text-xs text-sand-600 dark:text-sand-400 space-y-1 pt-2">
                  <p><strong class="text-sand-700 dark:text-sand-300">Time:</strong> {evt.data.time}</p>
                  <p><strong class="text-sand-700 dark:text-sand-300">Location:</strong> {evt.data.location}</p>
                  <p><strong class="text-sand-700 dark:text-sand-300">Distinguished Speaker:</strong> {evt.data.speaker} ({evt.data.speaker_title})</p>
                </div>

                <p class="text-xs text-sand-600 dark:text-sand-400 leading-relaxed">
                  {evt.data.summary}
                </p>
              </div>

              <div class="mt-4 pt-4 border-t border-sand-200 dark:border-night-800 flex items-center justify-between">
                <a href={`/events/${evt.slug}`} class="text-xs font-semibold text-forest-800 dark:text-gold-400 hover:underline">
                  Full Schedule & Details &rarr;
                </a>
                <a 
                  href={`/downloads/events/${evt.slug}.ics`} 
                  class="inline-flex items-center gap-1 px-3 py-1.5 rounded-md bg-sand-100 dark:bg-night-800 hover:bg-forest-800 hover:text-white dark:hover:bg-gold-500 dark:hover:text-night-950 text-xs font-medium transition-colors"
                >
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                  </svg>
                  <span>Export .ics</span>
                </a>
              </div>
            </div>
          ))}
        </div>
      </div>

    </div>
  </section>
</Layout>
