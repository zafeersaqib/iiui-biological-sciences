---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';

const forms = [
  { name: "MS Thesis Synopsis Submission Proforma", code: "FORM-BIO-01", category: "Postgraduate Forms", size: "340 KB" },
  { name: "PhD Comprehensive Exam Registration Form", code: "FORM-BIO-02", category: "Postgraduate Forms", size: "280 KB" },
  { name: "Turnitin Plagiarism Clearance Certificate Request", code: "FORM-BIO-03", category: "Academic Quality", size: "210 KB" },
  { name: "Laboratory Chemical & Reagent Requisition Slip", code: "FORM-BIO-04", category: "Laboratory Management", size: "190 KB" },
  { name: "Undergraduate Internship Completion Certificate Proforma", code: "FORM-BIO-05", category: "Undergraduate", size: "250 KB" },
  { name: "Department Clearance Certificate (Final Degree Issue)", code: "FORM-BIO-06", category: "Graduation", size: "310 KB" },
];
---

<Layout 
  title="Forms & Downloads | Department of Biological Sciences, IIUI"
  description="Download official departmental academic proformas, thesis guidelines, exam registration forms, and laboratory requisition slips."
>
  <Breadcrumb items={[{ label: 'Students', href: '/students/admissions' }, { label: 'Forms & Downloads' }]} />

  <section class="py-12 bg-white dark:bg-night-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">
      
      <div class="max-w-3xl space-y-3">
        <span class="text-xs font-semibold uppercase tracking-wider text-forest-800 dark:text-gold-400 font-sans">
          Official Documents & Proformas
        </span>
        <h1 class="text-3xl sm:text-5xl font-display font-bold text-sand-900 dark:text-sand-100">
          Forms & Downloads
        </h1>
        <p class="text-sand-600 dark:text-sand-400 text-sm leading-relaxed">
          Official PDF documents and proformas required for student registration, thesis proposals, laboratory requisitions, and graduation clearance.
        </p>
      </div>

      <div class="border border-sand-200 dark:border-night-800 rounded-2xl overflow-hidden bg-white dark:bg-night-900 shadow-sm">
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-sand-200 dark:divide-night-800 text-left text-xs">
            <thead class="bg-sand-50 dark:bg-night-850 text-sand-500 uppercase text-[10px] font-semibold">
              <tr>
                <th class="px-6 py-3">Document Code</th>
                <th class="px-6 py-3">Title / Form Description</th>
                <th class="px-6 py-3">Category</th>
                <th class="px-6 py-3">Format / Size</th>
                <th class="px-6 py-3 text-right">Action</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-sand-100 dark:divide-night-800 text-sand-800 dark:text-sand-200">
              {forms.map((f) => (
                <tr class="hover:bg-sand-50/70 dark:hover:bg-night-800/50 transition-colors">
                  <td class="px-6 py-3.5 font-mono font-semibold text-forest-700 dark:text-gold-400">{f.code}</td>
                  <td class="px-6 py-3.5 font-medium">{f.name}</td>
                  <td class="px-6 py-3.5 text-sand-500">{f.category}</td>
                  <td class="px-6 py-3.5 font-mono text-sand-500">PDF ({f.size})</td>
                  <td class="px-6 py-3.5 text-right">
                    <a href={`/downloads/${f.code.toLowerCase()}.pdf`} download class="inline-flex items-center gap-1 text-forest-800 dark:text-gold-400 font-semibold hover:underline">
                      <span>Download</span>
                      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
                      </svg>
                    </a>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

    </div>
  </section>
</Layout>
