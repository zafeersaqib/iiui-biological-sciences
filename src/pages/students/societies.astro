---
import Layout from '../../layouts/Layout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
---

<Layout 
  title="Student Societies & Life | Department of Biological Sciences, IIUI"
  description="Discover co-curricular life, the Biotechnology & Life Sciences Society, scientific symposia, and alumni achievements at IIUI."
>
  <Breadcrumb items={[{ label: 'Students', href: '/students/admissions' }, { label: 'Societies & Life' }]} />

  <section class="py-12 bg-white dark:bg-night-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <div class="max-w-3xl space-y-3">
        <span class="text-xs font-semibold uppercase tracking-wider text-forest-800 dark:text-gold-400 font-sans">
          Campus Life & Leadership
        </span>
        <h1 class="text-3xl sm:text-5xl font-display font-bold text-sand-900 dark:text-sand-100">
          Student Societies & Alumni
        </h1>
        <p class="text-sand-600 dark:text-sand-400 text-sm leading-relaxed">
          Beyond laboratory benches and lectures, our students build leadership skills, organize national scientific exhibitions, and participate in community health initiatives.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="p-8 rounded-2xl bg-sand-50 dark:bg-night-900 border border-sand-200 dark:border-night-800 space-y-4">
          <span class="px-2.5 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-forest-100 text-forest-800 dark:bg-forest-950 dark:text-forest-400">
            Active Student Body
          </span>
          <h2 class="text-2xl font-display font-bold text-sand-900 dark:text-sand-100">
            IIUI Biotechnology & Life Sciences Society (BLSS)
          </h2>
          <p class="text-xs sm:text-sm text-sand-600 dark:text-sand-400 leading-relaxed">
            The flagship student society organizes annual science fairs, DNA Day celebrations, guest lectures by eminent national scientists, and bioethics debates. Students in both male and female campus wings elect student office bearers annually.
          </p>
          <ul class="text-xs text-sand-700 dark:text-sand-300 space-y-1.5 pt-2">
            <li>&bull; Annual National Life Sciences Poster Competition</li>
            <li>&bull; World Health Day & Cancer Awareness Drives</li>
            <li>&bull; Industrial Exposure Trips to PARC, NIH, and Shaukat Khanum</li>
          </ul>
        </div>

        <div class="p-8 rounded-2xl bg-forest-900 text-white space-y-4">
          <span class="px-2.5 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-gold-500 text-forest-950">
            Global Impact
          </span>
          <h2 class="text-2xl font-display font-bold text-white">
            Alumni Network & Career Achievements
          </h2>
          <p class="text-xs sm:text-sm text-sand-200 leading-relaxed">
            Graduates of our BS, MS, and PhD programs serve in prestigious positions worldwide—pursuing post-doctoral fellowships across Europe, North America, and East Asia, managing clinical genomics diagnostics, and leading biotech startup ventures.
          </p>
          <div class="pt-2">
            <a href="https://www.iiu.edu.pk/?page_id=38" target="_blank" rel="noopener" class="text-xs font-semibold text-gold-300 hover:underline">
              Join the IIUI Alumni Association &rarr;
            </a>
          </div>
        </div>
      </div>

    </div>
  </section>
</Layout>
