---
import Layout from '../layouts/Layout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
---

<Layout 
  title="Contact Us & Campus Location | Department of Biological Sciences, IIUI"
  description="Contact information, office hours, departmental directory, inquiry form, and Google Map directions to the Department of Biological Sciences at Sector H-10, Islamabad."
>
  <Breadcrumb items={[{ label: 'Contact Us' }]} />

  <section class="py-12 bg-white dark:bg-night-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
      
      <!-- Page Header -->
      <div class="max-w-3xl space-y-3">
        <span class="text-xs font-semibold uppercase tracking-wider text-forest-800 dark:text-gold-400 font-sans">
          Inquiries & Location
        </span>
        <h1 class="text-3xl sm:text-5xl font-display font-bold text-sand-900 dark:text-sand-100">
          Contact the Department
        </h1>
        <p class="text-sand-600 dark:text-sand-400 text-sm leading-relaxed">
          Reach out for academic admissions advice, research collaboration proposals, graduate supervision inquiries, or general administrative questions.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
        
        <!-- Left: Coordinates & Visiting Hours (5 cols) -->
        <div class="lg:col-span-5 space-y-8">
          
          <div class="p-8 rounded-2xl bg-sand-50 dark:bg-night-900 border border-sand-200 dark:border-night-800 space-y-6">
            <h2 class="text-xl font-display font-bold text-forest-800 dark:text-gold-400">
              Department Secretariat
            </h2>

            <div class="space-y-4 text-xs text-sand-700 dark:text-sand-300 leading-relaxed">
              <div class="flex items-start gap-3">
                <svg class="w-5 h-5 text-forest-700 dark:text-gold-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
                <div>
                  <strong class="block text-sand-900 dark:text-sand-100 text-sm">Physical Address:</strong>
                  Faculty of Sciences, Science Block (Block D)<br />
                  International Islamic University Islamabad (IIUI)<br />
                  Sector H-10, Islamabad, 44000, Pakistan
                </div>
              </div>

              <div class="flex items-start gap-3 pt-2 border-t border-sand-200 dark:border-night-800">
                <svg class="w-5 h-5 text-forest-700 dark:text-gold-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                </svg>
                <div>
                  <strong class="block text-sand-900 dark:text-sand-100 text-sm">Telephone Contacts:</strong>
                  Chairperson Office: +92 (51) 9019837<br />
                  Department Academic Desk: +92 (51) 9019842<br />
                  Fax: +92 (51) 9257915
                </div>
              </div>

              <div class="flex items-start gap-3 pt-2 border-t border-sand-200 dark:border-night-800">
                <svg class="w-5 h-5 text-forest-700 dark:text-gold-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
                <div>
                  <strong class="block text-sand-900 dark:text-sand-100 text-sm">Official Email:</strong>
                  General Inquiries: <a href="mailto:biological.sciences@iiu.edu.pk" class="text-forest-800 dark:text-gold-400 underline">biological.sciences@iiu.edu.pk</a><br />
                  Admissions Support: <a href="https://admission.iiu.edu.pk/" target="_blank" rel="noopener" class="text-forest-800 dark:text-gold-400 underline">admission.iiu.edu.pk</a>
                </div>
              </div>

              <div class="flex items-start gap-3 pt-2 border-t border-sand-200 dark:border-night-800">
                <svg class="w-5 h-5 text-forest-700 dark:text-gold-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
                <div>
                  <strong class="block text-sand-900 dark:text-sand-100 text-sm">Official Office Hours:</strong>
                  Monday – Friday: 08:30 AM – 03:30 PM PKT<br />
                  <span class="text-sand-500 italic">(Closed on Saturdays, Sundays, and public holidays)</span>
                </div>
              </div>
            </div>

          </div>

        </div>

        <!-- Right: Inquiry Form (7 cols) -->
        <div class="lg:col-span-7 bg-white dark:bg-night-900 p-8 sm:p-10 rounded-2xl border border-sand-200 dark:border-night-800 shadow-xl space-y-6">
          <div class="space-y-1 border-b border-sand-200 dark:border-night-800 pb-4">
            <h2 class="text-2xl font-display font-bold text-sand-900 dark:text-sand-100">Send an Inquiry</h2>
            <p class="text-xs text-sand-500">Submit your message directly to the Department Admissions & Academic Desk.</p>
          </div>

          <form action="mailto:biological.sciences@iiu.edu.pk" method="GET" class="space-y-4 text-xs font-sans">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="full-name" class="block font-semibold text-sand-700 dark:text-sand-300">Your Full Name *</label>
                <input type="text" id="full-name" name="name" required class="mt-1 w-full px-3 py-2.5 rounded-lg border border-sand-300 dark:border-night-700 bg-sand-50/50 dark:bg-night-950 text-sand-900 dark:text-sand-100 focus:ring-2 focus:ring-forest-700" />
              </div>
              <div>
                <label for="email-addr" class="block font-semibold text-sand-700 dark:text-sand-300">Email Address *</label>
                <input type="email" id="email-addr" name="email" required class="mt-1 w-full px-3 py-2.5 rounded-lg border border-sand-300 dark:border-night-700 bg-sand-50/50 dark:bg-night-950 text-sand-900 dark:text-sand-100 focus:ring-2 focus:ring-forest-700" />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="contact-phone" class="block font-semibold text-sand-700 dark:text-sand-300">Phone / WhatsApp (Optional)</label>
                <input type="tel" id="contact-phone" name="phone" class="mt-1 w-full px-3 py-2.5 rounded-lg border border-sand-300 dark:border-night-700 bg-sand-50/50 dark:bg-night-950 text-sand-900 dark:text-sand-100 focus:ring-2 focus:ring-forest-700" />
              </div>
              <div>
                <label for="inquiry-category" class="block font-semibold text-sand-700 dark:text-sand-300">Inquiry Nature</label>
                <select id="inquiry-category" name="category" class="mt-1 w-full px-3 py-2.5 rounded-lg border border-sand-300 dark:border-night-700 bg-sand-50/50 dark:bg-night-950 text-sand-900 dark:text-sand-100 focus:ring-2 focus:ring-forest-700">
                  <option value="admissions">Undergraduate / Graduate Admissions</option>
                  <option value="research">Research Collaboration / Grant Inquiry</option>
                  <option value="thesis">Thesis Supervision / PhD Opportunity</option>
                  <option value="general">General Administrative Query</option>
                </select>
              </div>
            </div>

            <div>
              <label for="msg-subject" class="block font-semibold text-sand-700 dark:text-sand-300">Subject *</label>
              <input type="text" id="msg-subject" name="subject" required class="mt-1 w-full px-3 py-2.5 rounded-lg border border-sand-300 dark:border-night-700 bg-sand-50/50 dark:bg-night-950 text-sand-900 dark:text-sand-100 focus:ring-2 focus:ring-forest-700" />
            </div>

            <div>
              <label for="msg-body" class="block font-semibold text-sand-700 dark:text-sand-300">Detailed Message *</label>
              <textarea id="msg-body" name="body" rows="5" required class="mt-1 w-full px-3 py-2.5 rounded-lg border border-sand-300 dark:border-night-700 bg-sand-50/50 dark:bg-night-950 text-sand-900 dark:text-sand-100 focus:ring-2 focus:ring-forest-700"></textarea>
            </div>

            <button type="submit" class="w-full py-3 px-6 rounded-lg bg-forest-800 hover:bg-forest-900 text-white font-bold text-xs uppercase tracking-wider shadow-lg transition-colors">
              Submit Department Inquiry &rarr;
            </button>
          </form>
        </div>

      </div>

      <!-- Embedded Google Map -->
      <div class="space-y-4 pt-4">
        <h2 class="text-xl font-display font-bold text-sand-900 dark:text-sand-100">
          Campus Location Map (IIUI Sector H-10, Islamabad)
        </h2>
        <div class="h-96 rounded-2xl overflow-hidden border border-sand-200 dark:border-night-800 shadow-lg">
          <iframe 
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3319.8654813580554!2d73.02159187652702!3d33.65930067330761!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x38df959779df5c49%3A0x6331b265d66cbeec!2sInternational%20Islamic%20University%2C%20Islamabad!5e0!3m2!1sen!2s!4v1700000000000!5m2!1sen!2s" 
            width="100%" 
            height="100%" 
            style="border:0;" 
            allowfullscreen="" 
            loading="lazy" 
            referrerpolicy="no-referrer-when-downgrade"
            title="Google Map location of IIUI Sector H-10"
          ></iframe>
        </div>
      </div>

    </div>
  </section>
</Layout>
