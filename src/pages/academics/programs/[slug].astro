---
import Layout from '../../../layouts/Layout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const programs = await getCollection('programs');
  return programs.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
---

<Layout 
  title={`${entry.data.title} (${entry.data.code}) | Department of Biological Sciences, IIUI`}
  description={entry.data.overview}
>
  <Breadcrumb 
    items={[
      { label: 'Academics', href: '/academics' },
      { label: 'Programs', href: '/academics' },
      { label: `${entry.data.code} - ${entry.data.title}` }
    ]} 
  />

  <!-- Hero Header for Program -->
  <section class="bg-forest-950 text-white py-16 relative overflow-hidden">
    <div class="absolute inset-0 bg-bio-grid opacity-20"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 space-y-6">
      
      <div class="flex flex-wrap items-center gap-3">
        <span class="px-3 py-1 rounded font-mono text-sm font-bold bg-gold-500 text-forest-950">
          {entry.data.code}
        </span>
        <span class="px-3 py-1 rounded-full text-xs font-semibold bg-forest-900 border border-forest-700 text-sand-200 uppercase tracking-wider">
          {entry.data.degree_level} Degree
        </span>
        <span class="text-xs text-gold-400">HEC Approved Curriculum</span>
      </div>

      <h1 class="text-3xl sm:text-5xl font-display font-extrabold max-w-4xl leading-tight">
        {entry.data.title}
      </h1>

      <p class="max-w-3xl text-sand-200 text-sm sm:text-base leading-relaxed">
        {entry.data.overview}
      </p>

      <!-- Key Metadata Row -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 pt-4 border-t border-forest-800 text-xs">
        <div>
          <span class="block text-gold-400 uppercase font-semibold text-[10px]">Duration</span>
          <span class="font-medium text-white text-sm">{entry.data.duration}</span>
        </div>
        <div>
          <span class="block text-gold-400 uppercase font-semibold text-[10px]">Total Credits</span>
          <span class="font-medium text-white text-sm">{entry.data.credit_hours}</span>
        </div>
        <div>
          <span class="block text-gold-400 uppercase font-semibold text-[10px]">Admission Cycles</span>
          <span class="font-medium text-white text-sm">Fall & Spring Sessions</span>
        </div>
        <div>
          <span class="block text-gold-400 uppercase font-semibold text-[10px]">Campus</span>
          <span class="font-medium text-white text-sm">Male & Female Campuses</span>
        </div>
      </div>

      <div class="pt-2">
        <a 
          href={entry.data.admission_url || "https://admission.iiu.edu.pk/"} 
          target="_blank" 
          rel="noopener"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-lg bg-gold-500 hover:bg-gold-400 text-forest-950 font-bold text-xs uppercase tracking-wider shadow-lg transition-transform transform hover:-translate-y-0.5"
        >
          <span>Apply Online at IIUI Portal</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
          </svg>
        </a>
      </div>

    </div>
  </section>

  <!-- Interactive Program Tabs Section -->
  <section class="py-16 bg-sand-50 dark:bg-night-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Tab Controls -->
      <div class="border-b border-sand-200 dark:border-night-800 flex overflow-x-auto gap-2">
        <button class="prog-tab-btn active px-6 py-3 text-sm font-bold border-b-2 border-forest-800 text-forest-800 dark:text-gold-400 dark:border-gold-400 whitespace-nowrap" data-target="tab-curriculum">
          Scheme of Studies & Curriculum
        </button>
        <button class="prog-tab-btn px-6 py-3 text-sm font-bold border-b-2 border-transparent text-sand-600 dark:text-sand-400 hover:text-forest-800 dark:hover:text-gold-400 whitespace-nowrap" data-target="tab-eligibility">
          Eligibility & Admissions
        </button>
        <button class="prog-tab-btn px-6 py-3 text-sm font-bold border-b-2 border-transparent text-sand-600 dark:text-sand-400 hover:text-forest-800 dark:hover:text-gold-400 whitespace-nowrap" data-target="tab-plos">
          Learning Outcomes (PLOs)
        </button>
        <button class="prog-tab-btn px-6 py-3 text-sm font-bold border-b-2 border-transparent text-sand-600 dark:text-sand-400 hover:text-forest-800 dark:hover:text-gold-400 whitespace-nowrap" data-target="tab-careers">
          Career Pathways
        </button>
        {entry.data.faqs && entry.data.faqs.length > 0 && (
          <button class="prog-tab-btn px-6 py-3 text-sm font-bold border-b-2 border-transparent text-sand-600 dark:text-sand-400 hover:text-forest-800 dark:hover:text-gold-400 whitespace-nowrap" data-target="tab-faqs">
            FAQs
          </button>
        )}
      </div>

      <!-- Tab Panes Container -->
      <div class="mt-8 bg-white dark:bg-night-900 rounded-2xl shadow-xl border border-sand-200 dark:border-night-800 p-6 sm:p-10">
        
        <!-- PANE 1: CURRICULUM (Semester-wise Tables) -->
        <div id="tab-curriculum" class="prog-pane space-y-10">
          <div class="flex flex-wrap justify-between items-center pb-4 border-b border-sand-200 dark:border-night-800 gap-4">
            <div>
              <h2 class="text-xl font-display font-bold text-sand-900 dark:text-sand-100">Semester-Wise Scheme of Studies</h2>
              <p class="text-xs text-sand-500">Total Credit Hours: {entry.data.credit_hours} &bull; Approved by IIUI Academic Council</p>
            </div>
            <a href="/downloads/curriculum-placeholder.pdf" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md bg-sand-100 dark:bg-night-800 text-xs font-semibold text-sand-700 dark:text-sand-300 hover:bg-forest-800 hover:text-white transition-colors">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
              </svg>
              <span>Download Official Syllabus (PDF)</span>
            </a>
          </div>

          <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
            {entry.data.scheme_of_studies.map((sem) => (
              <div class="border border-sand-200 dark:border-night-800 rounded-xl overflow-hidden">
                <div class="bg-forest-50 dark:bg-night-850 px-4 py-2.5 border-b border-sand-200 dark:border-night-800 flex justify-between items-center">
                  <h3 class="text-xs font-bold uppercase tracking-wider text-forest-800 dark:text-gold-400 font-sans">
                    {sem.semester}
                  </h3>
                  <span class="text-[10px] text-sand-500 font-mono">
                    {sem.courses.length} Courses
                  </span>
                </div>
                <div class="overflow-x-auto">
                  <table class="min-w-full divide-y divide-sand-200 dark:divide-night-800 text-left text-xs">
                    <thead class="bg-sand-50/50 dark:bg-night-900 text-sand-500 text-[10px] uppercase font-semibold">
                      <tr>
                        <th class="px-4 py-2">Code</th>
                        <th class="px-4 py-2">Course Title</th>
                        <th class="px-4 py-2 text-right">Credit Hrs</th>
                      </tr>
                    </thead>
                    <tbody class="divide-y divide-sand-100 dark:divide-night-800">
                      {sem.courses.map((c) => (
                        <tr class="hover:bg-sand-50/70 dark:hover:bg-night-850/50 transition-colors">
                          <td class="px-4 py-2.5 font-mono font-semibold text-forest-700 dark:text-gold-400 whitespace-nowrap">{c.code}</td>
                          <td class="px-4 py-2.5 font-medium text-sand-800 dark:text-sand-200">{c.title}</td>
                          <td class="px-4 py-2.5 text-right font-mono text-sand-500 whitespace-nowrap">{c.credits}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </div>
            ))}
          </div>
        </div>

        <!-- PANE 2: ELIGIBILITY & ADMISSIONS -->
        <div id="tab-eligibility" class="prog-pane hidden space-y-6">
          <div class="max-w-3xl space-y-4">
            <h2 class="text-xl font-display font-bold text-sand-900 dark:text-sand-100">Admission Eligibility Criteria</h2>
            <div class="p-6 rounded-xl bg-sand-50 dark:bg-night-850 border border-sand-200 dark:border-night-800 text-sm leading-relaxed text-sand-800 dark:text-sand-200">
              {entry.data.eligibility}
            </div>

            <h3 class="text-base font-display font-bold text-forest-800 dark:text-gold-400 pt-4">Application Step-by-Step</h3>
            <ol class="space-y-3 text-xs text-sand-700 dark:text-sand-300 list-decimal list-inside leading-relaxed">
              <li>Visit the centralized IIUI Online Admission portal at <a href="https://admission.iiu.edu.pk/" target="_blank" rel="noopener" class="text-forest-800 dark:text-gold-400 underline font-semibold">admission.iiu.edu.pk</a>.</li>
              <li>Create a candidate account and submit your academic transcripts and identity documentation.</li>
              <li>Generate and pay the admission processing fee voucher at any designated Allied Bank Limited (ABL) or Meezan Bank branch.</li>
              <li>Appear in the departmental admission test / interview if required for postgraduate applicants (MSBT and PhDBT).</li>
              <li>Review the merit lists displayed online and proceed with fee submission to confirm admission.</li>
            </ol>
          </div>
        </div>

        <!-- PANE 3: PROGRAM LEARNING OUTCOMES -->
        <div id="tab-plos" class="prog-pane hidden space-y-6">
          <div class="max-w-3xl space-y-4">
            <h2 class="text-xl font-display font-bold text-sand-900 dark:text-sand-100">Program Learning Outcomes (PLOs)</h2>
            <p class="text-xs text-sand-500">Graduates of the {entry.data.title} are expected to attain the following core competencies:</p>
            <div class="space-y-3">
              {entry.data.plos.map((plo, idx) => (
                <div class="p-4 rounded-xl border border-sand-200 dark:border-night-800 flex items-start gap-4">
                  <span class="w-6 h-6 rounded-full bg-forest-800 text-white flex items-center justify-center text-xs font-bold shrink-0">
                    {idx + 1}
                  </span>
                  <p class="text-xs sm:text-sm text-sand-800 dark:text-sand-200 leading-relaxed font-medium">
                    {plo}
                  </p>
                </div>
              ))}
            </div>
          </div>
        </div>

        <!-- PANE 4: CAREER PATHWAYS -->
        <div id="tab-careers" class="prog-pane hidden space-y-6">
          <div class="max-w-3xl space-y-4">
            <h2 class="text-xl font-display font-bold text-sand-900 dark:text-sand-100">Career & Professional Prospects</h2>
            <p class="text-xs text-sand-500">Alumni of this program hold prominent roles across research, diagnostic, and industrial sectors:</p>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              {entry.data.career_prospects.map((career) => (
                <div class="p-4 rounded-xl bg-sand-50 dark:bg-night-850 border border-sand-200 dark:border-night-800 flex items-center gap-3">
                  <span class="w-2 h-2 rounded-full bg-gold-500 shrink-0"></span>
                  <span class="text-xs font-semibold text-sand-800 dark:text-sand-200">{career}</span>
                </div>
              ))}
            </div>
          </div>
        </div>

        <!-- PANE 5: FAQS (if available) -->
        {entry.data.faqs && entry.data.faqs.length > 0 && (
          <div id="tab-faqs" class="prog-pane hidden space-y-4 max-w-3xl">
            <h2 class="text-xl font-display font-bold text-sand-900 dark:text-sand-100 mb-4">Frequently Asked Questions</h2>
            {entry.data.faqs.map((faq) => (
              <details class="group border border-sand-200 dark:border-night-800 rounded-xl p-4 bg-sand-50/50 dark:bg-night-850/50">
                <summary class="font-semibold text-xs sm:text-sm text-sand-900 dark:text-sand-100 cursor-pointer flex justify-between items-center focus:outline-none">
                  <span>{faq.question}</span>
                  <svg class="w-4 h-4 text-sand-400 group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                  </svg>
                </summary>
                <p class="text-xs text-sand-600 dark:text-sand-400 mt-3 pt-3 border-t border-sand-200 dark:border-night-800 leading-relaxed">
                  {faq.answer}
                </p>
              </details>
            ))}
          </div>
        )}

      </div>

    </div>
  </section>
</Layout>

<script>
  const tabBtns = document.querySelectorAll('.prog-tab-btn');
  const panes = document.querySelectorAll('.prog-pane');

  tabBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const targetId = btn.getAttribute('data-target');

      tabBtns.forEach(b => {
        b.classList.remove('border-forest-800', 'text-forest-800', 'dark:text-gold-400', 'dark:border-gold-400');
        b.classList.add('border-transparent', 'text-sand-600', 'dark:text-sand-400');
      });
      btn.classList.add('border-forest-800', 'text-forest-800', 'dark:text-gold-400', 'dark:border-gold-400');
      btn.classList.remove('border-transparent', 'text-sand-600', 'dark:text-sand-400');

      panes.forEach(pane => pane.classList.add('hidden'));
      const activePane = document.getElementById(targetId || '');
      activePane?.classList.remove('hidden');
    });
  });
</script>
