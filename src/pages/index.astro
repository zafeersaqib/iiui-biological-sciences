---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const programs = await getCollection('programs');
const sortedPrograms = programs.sort((a, b) => a.data.order - b.data.order);

const faculty = await getCollection('faculty');
const sortedFaculty = faculty.sort((a, b) => (a.data.rank_order || 99) - (b.data.rank_order || 99));

const news = await getCollection('news');
const latestNews = news.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()).slice(0, 4);
---

<Layout 
  title="Department of Biological Sciences | International Islamic University Islamabad"
  description="Official homepage of the Department of Biological Sciences, Faculty of Sciences, IIUI. World-class life sciences education, genomic research, and academic degrees."
>

  <!-- 1. FROZEN HERO SLIDESHOW VIEWPORT (Sticky under top bar, covered by curtain on scroll) -->
  <section id="hero-slideshow" class="sticky top-[48px] sm:top-[54px] h-[calc(100vh-48px)] sm:h-[calc(100vh-54px)] w-full z-0 flex items-center justify-center overflow-hidden bg-[#0D1F0C] text-white">
    
    <!-- Slides Container -->
    <div id="slides-wrapper" class="absolute inset-0 z-0">
      
      <!-- Slide 1 -->
      <div class="hero-slide active absolute inset-0 transition-opacity duration-1000 opacity-100" data-caption="Advanced Molecular Biology & Genomic Investigation in Faculty Block I">
        <img 
          src="https://images.unsplash.com/photo-1532187863486-abf9dbad1b69?auto=format&fit=crop&w=1920&q=80" 
          alt="Advanced Molecular Biology & Genomic Investigation in Faculty Block I" 
          class="w-full h-full object-cover object-center brightness-75 scale-105 transition-transform duration-7000"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-[#0D1F0C] via-[#163013]/40 to-transparent"></div>
      </div>

      <!-- Slide 2 -->
      <div class="hero-slide absolute inset-0 transition-opacity duration-1000 opacity-0" data-caption="Cultivating Stress-Tolerant Indigenous Crops & Bioactive Metabolites">
        <img 
          src="https://images.unsplash.com/photo-1530497610245-94d3c16cda28?auto=format&fit=crop&w=1920&q=80" 
          alt="Plant Biotechnology & Tissue Culture Suite" 
          class="w-full h-full object-cover object-center brightness-75 scale-105 transition-transform duration-7000"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-[#0D1F0C] via-[#163013]/40 to-transparent"></div>
      </div>

      <!-- Slide 3 -->
      <div class="hero-slide absolute inset-0 transition-opacity duration-1000 opacity-0" data-caption="Satellite Remote Sensing & Biodiversity Conservation Across Margalla Reserves">
        <img 
          src="https://images.unsplash.com/photo-1511497584788-87676104235f?auto=format&fit=crop&w=1920&q=80" 
          alt="Spatial Ecology & Remote Sensing Lab" 
          class="w-full h-full object-cover object-center brightness-75 scale-105 transition-transform duration-7000"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-[#0D1F0C] via-[#163013]/40 to-transparent"></div>
      </div>

      <!-- Slide 4 -->
      <div class="hero-slide absolute inset-0 transition-opacity duration-1000 opacity-0" data-caption="Combating Antimicrobial Resistance (AMR) & Discovering Novel Therapeutics">
        <img 
          src="https://images.unsplash.com/photo-1579684385127-1ef15d508118?auto=format&fit=crop&w=1920&q=80" 
          alt="Microbiology and Biofilm Inhibition Research" 
          class="w-full h-full object-cover object-center brightness-75 scale-105 transition-transform duration-7000"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-[#0D1F0C] via-[#163013]/40 to-transparent"></div>
      </div>

      <!-- Slide 5 -->
      <div class="hero-slide absolute inset-0 transition-opacity duration-1000 opacity-0" data-caption="A Center of Higher Learning and Islamic Ethics in Islamabad (Sector H-10)">
        <img 
          src="https://images.unsplash.com/photo-1541339907198-e08756dedf3f?auto=format&fit=crop&w=1920&q=80" 
          alt="IIUI Academic Campus" 
          class="w-full h-full object-cover object-center brightness-75 scale-105 transition-transform duration-7000"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-[#0D1F0C] via-[#163013]/40 to-transparent"></div>
      </div>

    </div>

    <!-- Center Monumental Lockup: Compact Side-by-side Emblem + Centered Titles -->
    <div class="relative z-10 max-w-2xl sm:max-w-3xl lg:max-w-4xl mx-auto px-4 sm:px-8 py-4 sm:py-6 flex flex-col items-center justify-center space-y-3 sm:space-y-4 text-center select-none">
      
      <!-- Side-by-Side: Emblem on Left, Centered Sabon Titles on Right -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4 sm:gap-6 md:gap-7 text-center">
        <!-- Transparent Department Emblem on Left -->
        <div class="flex-shrink-0">
          <img 
            src="/assets/images/dept-logo.png" 
            alt="Department of Biological Sciences Crest" 
            class="h-16 sm:h-20 md:h-24 lg:h-28 w-auto object-contain drop-shadow-[0_10px_20px_rgba(0,0,0,0.85)] filter brightness-110 animate-fade-in"
          />
        </div>

        <!-- University & Department Titles: Centered Sabon Serif (Enhanced visibility & contrast) -->
        <div class="space-y-1.5 text-center">
          <div class="text-xs sm:text-sm md:text-base font-sans font-bold uppercase tracking-[0.2em] text-[#C1E899] drop-shadow-[0_2px_8px_rgba(0,0,0,0.9)]">
            International Islamic University Islamabad
          </div>
          <h1 class="text-2xl sm:text-3xl md:text-4xl lg:text-[2.65rem] font-serif font-normal tracking-wide text-white leading-tight drop-shadow-[0_4px_16px_rgba(0,0,0,0.95)]" style="font-family: 'Sabon', 'Sabon Next LT Pro', 'Source Serif 4', 'Garamond', 'Georgia', serif; font-weight: 400;">
            Department of Biological Sciences
          </h1>
          <div class="text-sm sm:text-base md:text-lg font-serif italic text-[#E6F0DC] font-normal drop-shadow-[0_2px_8px_rgba(0,0,0,0.9)]">
            Faculty of Sciences
          </div>
        </div>
      </div>

      <!-- Quranic Tagline (Surah Al-Ankabut 29:20) Compact Pill (Clear of slider fingers) -->
      <div class="inline-flex flex-col sm:flex-row items-center gap-2 sm:gap-3 px-4 py-1.5 sm:px-5 sm:py-2 rounded-full bg-[#0D1F0C]/90 border border-[#C1E899]/70 backdrop-blur-md shadow-2xl text-center">
        <span class="font-arabic text-[#C1E899] text-base sm:text-lg font-bold">قُلْ سِيرُوا فِي الْأَرْضِ فَانظُرُوا كَيْفَ بَدَأَ الْخَلْقَ ۚ</span>
        <span class="hidden sm:inline-block w-1.5 h-1.5 rounded-full bg-[#9A6735]"></span>
        <span class="text-xs sm:text-sm font-sans font-normal text-white">
          "Say: 'Travel through the earth and see how Allah did originate creation...'" <span class="text-[#C1E899] font-semibold">(29:20)</span>
        </span>
      </div>

    </div>

    <!-- Hero Bottom Bar: Slide Controls & Dynamic Caption (Bottom-Left) -->
    <div class="absolute bottom-6 left-6 sm:left-12 right-6 sm:right-12 z-20 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
      
      <!-- Left: Pause Button + Caption -->
      <div class="flex items-center gap-3">
        <!-- Pause/Play Circular Button -->
        <button 
          id="slideshow-pause-btn" 
          type="button" 
          class="w-10 h-10 rounded-full bg-white/20 hover:bg-white/40 text-white border border-white/40 flex items-center justify-center transition-colors focus:outline-none focus:ring-2 focus:ring-[#C1E899]"
          aria-label="Pause background slideshow"
          title="Pause Slideshow"
        >
          <svg id="pause-icon" class="w-4 h-4 fill-current" viewBox="0 0 24 24">
            <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/>
          </svg>
          <svg id="play-icon" class="w-4 h-4 fill-current hidden" viewBox="0 0 24 24">
            <path d="M8 5v14l11-7z"/>
          </svg>
        </button>

        <!-- Dynamic Caption Text -->
        <span id="hero-caption" class="text-xs sm:text-sm font-sans text-[#E6F0DC] drop-shadow max-w-lg">
          Advanced Molecular Biology & Genomic Investigation in Faculty Block I
        </span>
      </div>

      <!-- Right: Slide Number Indicators -->
      <div class="flex items-center space-x-2">
        <button class="slide-indicator active w-3 h-3 rounded-full bg-[#C1E899] border border-[#C1E899] transition-all" data-index="0" aria-label="Go to slide 1"></button>
        <button class="slide-indicator w-3 h-3 rounded-full bg-white/40 hover:bg-[#C1E899] border border-white/60 transition-all" data-index="1" aria-label="Go to slide 2"></button>
        <button class="slide-indicator w-3 h-3 rounded-full bg-white/40 hover:bg-[#C1E899] border border-white/60 transition-all" data-index="2" aria-label="Go to slide 3"></button>
        <button class="slide-indicator w-3 h-3 rounded-full bg-white/40 hover:bg-[#C1E899] border border-white/60 transition-all" data-index="3" aria-label="Go to slide 4"></button>
        <button class="slide-indicator w-3 h-3 rounded-full bg-white/40 hover:bg-[#C1E899] border border-white/60 transition-all" data-index="4" aria-label="Go to slide 5"></button>
      </div>

    </div>

  </section>

  <!-- 2. ROLLING CURTAIN CONTAINER: Covers the frozen hero on scroll with torn paper deckle edge -->
  <div id="curtain-container" class="relative z-10 bg-[#23491E] shadow-[0_-25px_50px_rgba(0,0,0,0.6)]">
    
    <!-- TORN PAPER DECKLE EDGE (Authentic White Ripped Fiber Line Over Section Top) -->
    <div class="absolute -top-11 sm:-top-15 md:-top-18 left-0 right-0 w-full overflow-hidden pointer-events-none z-30 select-none">
      <img 
        src="/assets/images/torn-paper-edge.svg" 
        alt="" 
        class="w-full h-12 sm:h-16 md:h-20 object-cover object-bottom" 
      />
    </div>

    <!-- a) BOLD STATEMENT BANNER: SCIENCE SERVES LIFE (Forest Green with #C1E899 Sprout Highlight) -->
    <section class="relative bg-[#23491E] text-white pt-24 pb-24 sm:pt-32 sm:pb-32 overflow-hidden">
    
    <!-- Ragged Header Texture -->
    <div class="absolute top-0 inset-x-0 h-4 bg-repeat-x opacity-30" style="background-image: radial-gradient(circle at 10px 0, transparent 0, transparent 8px, #23491E 8px); background-size: 20px 20px;"></div>

    <div class="max-w-7xl mx-auto px-6 sm:px-10 lg:px-12">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        
        <!-- Large Two-Tone Headline in Work Sans Ultra-Bold -->
        <div class="lg:col-span-7 space-y-1">
          <div class="text-6xl sm:text-7xl lg:text-8xl font-black font-sans tracking-tight text-white uppercase leading-none">
            Science
          </div>
          <div class="text-6xl sm:text-7xl lg:text-8xl font-black font-sans tracking-tight text-[#C1E899] uppercase leading-none">
            Serves Life.
          </div>
        </div>

        <!-- Narrative Paragraph + Button (Right Column) -->
        <div class="lg:col-span-5 space-y-6">
          <p class="text-base sm:text-lg text-[#E6F0DC] font-sans leading-relaxed">
            Without bioscience research—at the International Islamic University Islamabad and across leading academic centers—advancements in disease therapeutics, agricultural resilience, and environmental sustainability slow down. Our laboratories drive the discoveries of tomorrow.
          </p>
          <div>
            <a 
              href="/research/areas" 
              class="inline-block px-7 py-3.5 border-2 border-white text-white font-sans font-extrabold text-xs uppercase tracking-widest hover:bg-white hover:text-[#23491E] transition-colors shadow-md rounded-sm"
            >
              MORE ABOUT OUR RESEARCH
            </a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- b) "DISCOVER" SHORT LINK LIST (#E6F0DC Pastel Sage Canvas) -->
  <section class="bg-[#E6F0DC] dark:bg-[#163013] border-b border-[#D0DEC0] dark:border-[#2D5724] py-12">
    <div class="max-w-7xl mx-auto px-6 sm:px-8">
      
      <!-- Centered DISCOVER Tag in Oswald Condensed -->
      <div class="flex justify-center mb-8">
        <span class="border-2 border-[#55883B] dark:border-[#C1E899] px-6 py-1.5 text-xs badge-oswald text-[#23491E] dark:text-[#C1E899] uppercase bg-white/70 dark:bg-[#0D1F0C]/60 rounded-sm">
          DISCOVER
        </span>
      </div>

      <!-- 4 Horizontal Short Links with Dividers -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 lg:divide-x divide-[#D0DEC0] dark:divide-[#2D5724]">
        
        <div class="px-3 text-center sm:text-left space-y-1 group">
          <a href="/academics/programs/bs-biotechnology" class="block font-sans font-bold text-base text-[#23491E] dark:text-white group-hover:text-[#55883B] dark:group-hover:text-[#C1E899] transition-colors">
            Undergraduate Research Opportunities
          </a>
          <p class="text-xs text-[#5F724C] dark:text-[#B8CBB0] font-sans">Direct wet-lab immersion for BS Biology & Biotechnology scholars.</p>
        </div>

        <div class="px-3 text-center sm:text-left space-y-1 group">
          <a href="/research/projects" class="block font-sans font-bold text-base text-[#23491E] dark:text-white group-hover:text-[#55883B] dark:group-hover:text-[#C1E899] transition-colors">
            Provost & Chairperson Research Awards
          </a>
          <p class="text-xs text-[#5F724C] dark:text-[#B8CBB0] font-sans">Competitive seed funding for high-impact postgraduate theses.</p>
        </div>

        <div class="px-3 text-center sm:text-left space-y-1 group">
          <a href="/research/labs" class="block font-sans font-bold text-base text-[#23491E] dark:text-white group-hover:text-[#55883B] dark:group-hover:text-[#C1E899] transition-colors">
            Genomics & Molecular Diagnostic Core
          </a>
          <p class="text-xs text-[#5F724C] dark:text-[#B8CBB0] font-sans">Specialized instrumentation, thermal cyclers, and bioreactors.</p>
        </div>

        <div class="px-3 text-center sm:text-left space-y-1 group">
          <a href="/academics/programs/phd-biotechnology" class="block font-sans font-bold text-base text-[#23491E] dark:text-white group-hover:text-[#55883B] dark:group-hover:text-[#C1E899] transition-colors">
            Doctoral Fellowship Program
          </a>
          <p class="text-xs text-[#5F724C] dark:text-[#B8CBB0] font-sans">PhD assistantships mentored by senior tenured professors.</p>
        </div>

      </div>

    </div>
  </section>

  <!-- c) STORIES OF IMPACT / 4 NEWS CARDS (JHU .stories in Forest Green) -->
  <section class="py-24 bg-white dark:bg-[#0D1F0C] border-b border-[#D0DEC0] dark:border-[#2D5724]">
    <div class="max-w-7xl mx-auto px-6 sm:px-10 lg:px-12 space-y-12">
      
      <!-- Section Intro Header in Work Sans -->
      <div class="max-w-2xl space-y-3">
        <span class="badge-oswald text-xs text-[#55883B] dark:text-[#C1E899]">
          Stories of Impact
        </span>
        <h2 class="text-3xl sm:text-5xl font-sans font-bold text-[#23491E] dark:text-white tracking-tight">
          Pioneering Research Across Disciplines
        </h2>
        <p class="text-sm sm:text-base text-[#5F724C] dark:text-[#B8CBB0] font-sans">
          Select a story below to see how our faculty and doctoral scholars lay the groundwork for breakthroughs in diagnostics, sustainable agriculture, and cellular therapeutics.
        </p>
      </div>

      <!-- Top News Grid: 1 Large Lead Feature + 3 Cards -->
      <div class="space-y-10">
        
        <!-- Large Featured Story (Top) with Rounded 3xl & Forest Glassmorphism Container -->
        <article class="relative rounded-3xl overflow-hidden bg-[#F4F8EE] dark:bg-[#163013] border border-[#D0DEC0] dark:border-[#2D5724] shadow-lg hover:shadow-2xl transition-all duration-300 grid grid-cols-1 lg:grid-cols-12 gap-0 group">
          <div class="lg:col-span-7 h-80 sm:h-96 lg:h-full min-h-[380px] overflow-hidden relative">
            <img 
              src="https://images.unsplash.com/photo-1579165466791-788226ab77b6?auto=format&fit=crop&w=1200&q=80" 
              alt="Public Health Diagnostic Research at IIUI" 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
            />
            <!-- Circular Action Arrow Button (Green Accent) -->
            <a 
              href="/news" 
              class="absolute bottom-6 right-6 w-12 h-12 rounded-full bg-[#55883B] hover:bg-[#23491E] text-white flex items-center justify-center transition-all shadow-xl group-hover:scale-110"
              aria-label="Read full story"
            >
              <svg class="w-5 h-5 stroke-[2.5]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>
          </div>

          <div class="lg:col-span-5 p-8 sm:p-10 flex flex-col justify-between space-y-4 bg-white dark:bg-[#163013]">
            <div class="space-y-3">
              <span class="badge-oswald text-xs text-[#55883B] dark:text-[#C1E899]">
                PUBLIC HEALTH & DIAGNOSTICS
              </span>
              <h3 class="text-2xl sm:text-3xl font-sans font-bold text-[#23491E] dark:text-white leading-tight">
                The Diagnostic Vanguard: Rapid Molecular Panels for Clinical Pathogens
              </h3>
              <div class="text-xs text-[#75866E] font-sans font-medium">
                Fall 2026 &middot; IIUI Biosciences Research Desk
              </div>
              <p class="text-sm text-[#4B5E44] dark:text-[#B8CBB0] font-sans leading-relaxed">
                At the Applied Molecular Biology Laboratory, faculty and doctoral researchers are engineering high-specificity isothermal PCR assays to detect resistant bacterial strains and viral vectors in clinical cohorts across Islamabad and Rawalpindi.
              </p>
            </div>
            <div class="pt-4 border-t border-[#D0DEC0] dark:border-[#2D5724]">
              <a href="/news" class="font-sans font-bold text-xs uppercase tracking-wider text-[#55883B] dark:text-[#C1E899] hover:underline flex items-center gap-1.5">
                <span>View Story of Impact</span>
                <span class="text-sm">&rarr;</span>
              </a>
            </div>
          </div>
        </article>

        <!-- 3 Secondary Grid Cards Below -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          
          <!-- Card 1: Agricultural Plant Biotechnology -->
          <article class="relative flex flex-col group">
            <div class="relative w-full aspect-square rounded-3xl overflow-hidden shadow-md">
              <img 
                src="https://images.unsplash.com/photo-1530497610245-94d3c16cda28?auto=format&fit=crop&w=600&q=80" 
                alt="Agricultural Plant Biotechnology" 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
              <a 
                href="/news" 
                class="absolute bottom-10 right-4 w-10 h-10 rounded-full bg-[#55883B] hover:bg-[#23491E] text-white flex items-center justify-center transition-all shadow-lg group-hover:scale-110 z-10"
                aria-label="Read story"
              >
                <svg class="w-4 h-4 stroke-[2.5]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>
            </div>
            <div class="jhu-glass-card p-6 -mt-8 mx-3 relative z-0 text-white space-y-2">
              <span class="badge-oswald text-[11px] text-[#C1E899]">
                MOLECULAR BIOLOGY
              </span>
              <h4 class="text-base font-sans font-bold text-white leading-snug">
                <a href="/news" class="hover:underline">Engineering Drought-Tolerant Crops for Arid Ecosystems</a>
              </h4>
              <div class="text-[11px] text-[#D5ECC0] font-sans">Oct 20, 2026</div>
              <p class="text-xs text-[#E6F0DC] font-sans line-clamp-2">
                Novel transformation vectors express protective chaperones to enhance crop productivity under severe drought conditions.
              </p>
            </div>
          </article>

          <!-- Card 2: Faculty Keynote / Landscape Ecology -->
          <article class="relative flex flex-col group">
            <div class="relative w-full aspect-square rounded-3xl overflow-hidden shadow-md">
              <img 
                src="/assets/images/zafeer_saqib.jpg" 
                alt="Prof. Dr. Zafeer Saqib" 
                class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-500"
              />
              <a 
                href="/people/faculty/zafeer-saqib" 
                class="absolute bottom-10 right-4 w-10 h-10 rounded-full bg-[#55883B] hover:bg-[#23491E] text-white flex items-center justify-center transition-all shadow-lg group-hover:scale-110 z-10"
                aria-label="View profile"
              >
                <svg class="w-4 h-4 stroke-[2.5]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>
            </div>
            <div class="jhu-glass-card p-6 -mt-8 mx-3 relative z-0 text-white space-y-2">
              <span class="badge-oswald text-[11px] text-[#C1E899]">
                FACULTY HONORS
              </span>
              <h4 class="text-base font-sans font-bold text-white leading-snug">
                <a href="/people/faculty/zafeer-saqib" class="hover:underline">Prof. Dr. Zafeer Saqib Delivers Keynote on Landscape Ecology</a>
              </h4>
              <div class="text-[11px] text-[#D5ECC0] font-sans">Oct 16, 2026</div>
              <p class="text-xs text-[#E6F0DC] font-sans line-clamp-2">
                Highlighting satellite remote sensing models and multi-decadal vegetation fragmentation at the National Ecological Assembly.
              </p>
            </div>
          </article>

          <!-- Card 3: Cancer Oncology Research -->
          <article class="relative flex flex-col group">
            <div class="relative w-full aspect-square rounded-3xl overflow-hidden shadow-md">
              <img 
                src="https://images.unsplash.com/photo-1532187863486-abf9dbad1b69?auto=format&fit=crop&w=600&q=80" 
                alt="Cancer Biology Research" 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
              <a 
                href="/people/faculty/sobia-tabassum" 
                class="absolute bottom-10 right-4 w-10 h-10 rounded-full bg-[#55883B] hover:bg-[#23491E] text-white flex items-center justify-center transition-all shadow-lg group-hover:scale-110 z-10"
                aria-label="Read dispatch"
              >
                <svg class="w-4 h-4 stroke-[2.5]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>
            </div>
            <div class="jhu-glass-card p-6 -mt-8 mx-3 relative z-0 text-white space-y-2">
              <span class="badge-oswald text-[11px] text-[#C1E899]">
                CANCER THERAPEUTICS
              </span>
              <h4 class="text-base font-sans font-bold text-white leading-snug">
                <a href="/people/faculty/sobia-tabassum" class="hover:underline">Prof. Dr. Sobia Tabassum Publishes on 3D Tumor Spheroids</a>
              </h4>
              <div class="text-[11px] text-[#D5ECC0] font-sans">Oct 10, 2026</div>
              <p class="text-xs text-[#E6F0DC] font-sans line-clamp-2">
                Groundbreaking findings on therapeutic delivery in drug-resistant solid tumors published in premier oncology journal.
              </p>
            </div>
          </article>

        </div>

      </div>

