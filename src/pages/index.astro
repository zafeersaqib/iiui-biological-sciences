<script>
  // Hero Floating Side Rail Scroll Dissolve
  const heroSideRail = document.getElementById('hero-side-rail');
  window.addEventListener('scroll', () => {
    const drawer = document.getElementById('side-menu-drawer');
    const isDrawerOpen = drawer && !drawer.classList.contains('translate-x-full');
    if (window.scrollY > 100 && !isDrawerOpen) {
      heroSideRail?.classList.add('opacity-0', 'pointer-events-none', 'translate-x-6');
    } else {
      heroSideRail?.classList.remove('opacity-0', 'pointer-events-none', 'translate-x-6');
    }
  }, { passive: true });
  // 1. Hero Slideshow Auto-Rotation & Controls
  const slides = document.querySelectorAll('.hero-slide');
  const captionEl = document.getElementById('hero-caption');
  const pauseBtn = document.getElementById('slideshow-pause-btn');
  const pauseIcon = document.getElementById('pause-icon');
  const playIcon = document.getElementById('play-icon');
  const indicators = document.querySelectorAll('.slide-indicator');

  let currentSlide = 0;
  let isPaused = false;
  let slideTimer: any = null;

  function showSlide(index: number) {
    slides.forEach((s, idx) => {
      if (idx === index) {
        s.classList.add('opacity-100', 'active');
        s.classList.remove('opacity-0');
        const caption = s.getAttribute('data-caption');
        if (captionEl && caption) captionEl.textContent = caption;
      } else {
        s.classList.remove('opacity-100', 'active');
        s.classList.add('opacity-0');
      }
    });

    indicators.forEach((ind, idx) => {
      if (idx === index) {
        ind.classList.add('bg-[#C1E899]');
        ind.classList.remove('bg-white/40');
      } else {
        ind.classList.remove('bg-[#C1E899]');
        ind.classList.add('bg-white/40');
      }
    });

    currentSlide = index;
  }

  function nextSlide() {
    const next = (currentSlide + 1) % slides.length;
    showSlide(next);
  }

  function startTimer() {
    clearInterval(slideTimer);
    slideTimer = setInterval(() => {
      if (!isPaused) nextSlide();
    }, 6000);
  }

  pauseBtn?.addEventListener('click', () => {
    isPaused = !isPaused;
    if (isPaused) {
      pauseIcon?.classList.add('hidden');
      playIcon?.classList.remove('hidden');
      pauseBtn.setAttribute('title', 'Play Slideshow');
    } else {
      playIcon?.classList.add('hidden');
      pauseIcon?.classList.remove('hidden');
      pauseBtn.setAttribute('title', 'Pause Slideshow');
    }
  });

  indicators.forEach(ind => {
    ind.addEventListener('click', () => {
      const idx = parseInt(ind.getAttribute('data-index') || '0', 10);
      showSlide(idx);
      startTimer();
    });
  });

  startTimer();

  // 2. Meet Our People Quote Swapper
  const personThumbs = document.querySelectorAll('.person-thumb');
  const featuredQuote = document.getElementById('featured-person-quote');
  const featuredName = document.getElementById('featured-person-name');
  const featuredTitle = document.getElementById('featured-person-title');
  const featuredImg = document.getElementById('featured-person-img') as HTMLImageElement | null;
  const featuredLink = document.getElementById('featured-person-link') as HTMLAnchorElement | null;

  personThumbs.forEach(thumb => {
    thumb.addEventListener('click', () => {
      personThumbs.forEach(t => {
        t.classList.remove('active', 'border-[#55883B]', 'dark:border-[#C1E899]', 'border-3', 'ring-2', 'ring-[#C1E899]');
        t.classList.add('border-[#D0DEC0]', 'dark:border-[#2D5724]', 'border-2');
      });

      thumb.classList.add('active', 'border-[#55883B]', 'dark:border-[#C1E899]', 'border-3', 'ring-2', 'ring-[#C1E899]');
      thumb.classList.remove('border-[#D0DEC0]', 'dark:border-[#2D5724]', 'border-2');

      const name = thumb.getAttribute('data-name');
      const title = thumb.getAttribute('data-title');
      const quote = thumb.getAttribute('data-quote');
      const img = thumb.getAttribute('data-img');
      const link = thumb.getAttribute('data-link');

      if (featuredName && name) featuredName.textContent = name;
      if (featuredTitle && title) featuredTitle.textContent = title;
      if (featuredQuote && quote) featuredQuote.textContent = quote;
      if (featuredImg && img) {
        featuredImg.src = img;
        featuredImg.alt = name || 'Faculty Member';
      }
      if (featuredLink && link) featuredLink.href = link;
    });
  });

  // 3. Program Search Filtering
  const programSearchInput = document.getElementById('program-search-input') as HTMLInputElement | null;
  const programItems = document.querySelectorAll('.program-item');

  programSearchInput?.addEventListener('input', () => {
    const q = (programSearchInput.value || '').toLowerCase().trim();
    programItems.forEach(item => {
      const text = item.textContent?.toLowerCase() || '';
      if (!q || text.includes(q)) {
        (item as HTMLElement).style.display = 'block';
      } else {
        (item as HTMLElement).style.display = 'none';
      }
    });
  });
</script>
