---
import Layout from '../layouts/Layout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';

const albums = [
  {
    title: "Molecular Research Laboratories",
    category: "Facilities",
    images: [
      { src: "/assets/images/bio_home.png", caption: "Department Biotechnology & Life Sciences Laboratory", credit: "IIUI Official" },
      { src: "/assets/images/faculty-placeholder.svg", caption: "Real-Time PCR and Gel Electrophoresis Benches", credit: "Department Archive" },
      { src: "/assets/images/faculty-placeholder.svg", caption: "Microbial Fermentation & Bioreactor Unit", credit: "AMBL Laboratory" },
    ]
  },
  {
    title: "National Conferences & Seminars",
    category: "Events",
    images: [
      { src: "/assets/images/bio_home.png", caption: "National Symposium on Human Genomics at IIUI Auditorium", credit: "IIUI Media Wing" },
      { src: "/assets/images/faculty-placeholder.svg", caption: "Postgraduate Thesis Defense & Viva-Voce Sessions", credit: "Faculty of Sciences" },
    ]
  },
  {
    title: "Campus Life & Botanical Grounds",
    category: "Campus",
    images: [
      { src: "/assets/images/bio_home.png", caption: "Faculty of Sciences Academic Quadrangle, Sector H-10", credit: "IIUI PR Wing" },
    ]
  }
];
---

<Layout 
  title="Photo Gallery & Facilities Archive | Department of Biological Sciences, IIUI"
  description="Explore photographic albums of research laboratories, instrumentation suites, student academic symposia, and campus life at IIUI."
>
  <Breadcrumb items={[{ label: 'Gallery' }]} />

  <section class="py-12 bg-white dark:bg-night-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <div class="max-w-3xl space-y-3">
        <span class="text-xs font-semibold uppercase tracking-wider text-forest-800 dark:text-gold-400 font-sans">
          Visual Archive
        </span>
        <h1 class="text-3xl sm:text-5xl font-display font-bold text-sand-900 dark:text-sand-100">
          Department Gallery & Facilities
        </h1>
        <p class="text-sand-600 dark:text-sand-400 text-sm leading-relaxed">
          Glimpses into our research spaces, postgraduate student symposia, international guest lectures, and campus life.
        </p>
      </div>

      <!-- Albums Grid -->
      <div class="space-y-12">
        {albums.map((album) => (
          <div class="space-y-4">
            <div class="flex items-center justify-between border-b border-sand-200 dark:border-night-800 pb-2">
              <h2 class="text-xl font-display font-bold text-sand-900 dark:text-sand-100">{album.title}</h2>
              <span class="text-xs px-2.5 py-0.5 rounded-full bg-sand-100 dark:bg-night-800 text-sand-600 dark:text-sand-400 font-medium">
                {album.category} ({album.images.length} photos)
              </span>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
              {album.images.map((img) => (
                <div 
                  class="gallery-item group relative h-64 rounded-xl overflow-hidden bg-sand-200 dark:bg-night-800 cursor-pointer shadow-md"
                  data-src={img.src}
                  data-caption={img.caption}
                  data-credit={img.credit}
                >
                  <img 
                    src={img.src} 
                    alt={img.caption}
                    class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity p-4 flex flex-col justify-end text-white">
                    <p class="text-xs font-semibold leading-snug">{img.caption}</p>
                    <p class="text-[10px] text-gold-300 mt-1">Photo: {img.credit}</p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- Lightbox Modal -->
  <div id="lightbox-modal" class="fixed inset-0 z-50 hidden bg-black/90 backdrop-blur-md p-4 flex flex-col justify-center items-center">
    <button id="close-lightbox" class="absolute top-6 right-6 text-white hover:text-gold-400 p-2 focus:outline-none" aria-label="Close Lightbox">
      <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>
    <div class="max-w-4xl max-h-[80vh] flex flex-col items-center">
      <img id="lightbox-img" src="" alt="Enlarged gallery photo" class="max-w-full max-h-[70vh] rounded-lg shadow-2xl object-contain" />
      <div class="mt-4 text-center text-white">
        <p id="lightbox-caption" class="text-sm font-semibold"></p>
        <p id="lightbox-credit" class="text-xs text-gold-400 mt-0.5"></p>
      </div>
    </div>
  </div>
</Layout>

<script>
  const galleryItems = document.querySelectorAll('.gallery-item');
  const lightbox = document.getElementById('lightbox-modal');
  const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
  const lightboxCaption = document.getElementById('lightbox-caption');
  const lightboxCredit = document.getElementById('lightbox-credit');
  const closeBtn = document.getElementById('close-lightbox');

  galleryItems.forEach(item => {
    item.addEventListener('click', () => {
      const src = item.getAttribute('data-src') || '';
      const caption = item.getAttribute('data-caption') || '';
      const credit = item.getAttribute('data-credit') || '';

      if (lightboxImg) lightboxImg.src = src;
      if (lightboxCaption) lightboxCaption.textContent = caption;
      if (lightboxCredit) lightboxCredit.textContent = `Credit: ${credit}`;

      lightbox?.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    });
  });

  function closeLightbox() {
    lightbox?.classList.add('hidden');
    document.body.style.overflow = '';
  }

  closeBtn?.addEventListener('click', closeLightbox);
  lightbox?.addEventListener('click', (e) => {
    if (e.target === lightbox) closeLightbox();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !lightbox?.classList.contains('hidden')) {
      closeLightbox();
    }
  });
</script>
